// TTFT/Latency Query
// Description: Calculates the average Time to first response for SRE Agent threads for first party and third party customers separately
// Database: https://sreagent-sec.swedencentral.kusto.windows.net/sreagent

// Friday-based week calculation: get the Friday that starts the week containing a date

let startTime = datetime(2025-12-05T00:00:00.000Z);
let endTime = now();
// Get agent category using AgentUniqueName which matches AgentActionEvents.AgentName
let AgentCategories = ExtendedAgentDocumentDBState()
| extend AgentName = tostring(AgentUniqueName)
| extend CustomerCategory = tostring(CustomerCategory)
| where isnotempty(CustomerCategory)
| summarize CustomerCategory = max(CustomerCategory) by AgentName;
let UserMsgs = All("AgentActionEvents")
| where PreciseTimeStamp >= startTime and PreciseTimeStamp < endTime
| where Action == "CreateUserMessage"
| where AgentName !startswith "e2e" and AgentName !startswith "crud"
| project ThreadId, UserTime = PreciseTimeStamp, AgentName = tostring(AgentName);
let AgentMsgs = All("AgentActionEvents")
| where PreciseTimeStamp >= startTime and PreciseTimeStamp < endTime
| where Action == "CreateAgentMessage"
| where AgentName !startswith "e2e" and AgentName !startswith "crud"
| project ThreadId, AgentTime = PreciseTimeStamp;
let LatencyData = UserMsgs
| join kind=inner (AgentMsgs) on ThreadId
| extend Duration = AgentTime - UserTime
| where Duration >= 0ms
| lookup AgentCategories on AgentName
| where isnotempty(CustomerCategory)
| summarize FirstRespLatency = min(Duration), CustomerCategory = max(CustomerCategory) by ThreadId, bin(UserTime, 7d)
| extend LatencySeconds = tolong(FirstRespLatency / 1ms)
| extend CustomWeek = bin(UserTime + 3d, 7d) - 3d;
// Overall metrics
let OverallMetrics = LatencyData
| summarize
    P50_seconds = percentile(LatencySeconds, 50),
    P90_seconds = percentile(LatencySeconds, 90),
    P95_seconds = percentile(LatencySeconds, 95),
    P99_seconds = percentile(LatencySeconds, 99)
    by CustomWeek;
// FirstParty P50
let FirstPartyMetrics = LatencyData
| where CustomerCategory == "FirstParty"
| summarize FirstParty_P50_seconds = percentile(LatencySeconds, 50) by CustomWeek;
// ThirdParty P50
let ThirdPartyMetrics = LatencyData
| where CustomerCategory == "ThirdParty"
| summarize ThirdParty_P50_seconds = percentile(LatencySeconds, 50) by CustomWeek;
// Combine all metrics
OverallMetrics
| join kind=leftouter (FirstPartyMetrics) on CustomWeek
| join kind=leftouter (ThirdPartyMetrics) on CustomWeek
| where P50_seconds < 314785364 and P99_seconds < 214785364
| order by CustomWeek asc
| project
    CustomWeek,
    P50_seconds,
    FirstParty_P50_seconds,
    ThirdParty_P50_seconds,
    P90_seconds,
    P95_seconds,
    P99_seconds
