// UniqueAgents-FirstParty Query
// Description: Gives the unique agents and unique service groups belonging to first party customers over the past one week
// Database: https://sreagent-sec.swedencentral.kusto.windows.net/sreagent

// Friday-based week calculation: get the Friday that starts the week containing a date

// Define time range variables for easier maintenance
let startTime = datetime(2025-09-05T00:00:00.000Z);  // Example: Start of analysis period
let endTime = now();    // Example: End of analysis period (exclusive)
// Define tenant IDs
let ameTenantId = "33e01921-4d64-4f8c-a055-5bdaffd5e33d";
let pmeTenantId = "975f013f-7f24-47e8-a7d3-abc4752bf346";
let torusTenantId = "72f988bf-86f1-41af-91ab-2d7cd011db47";  // TORUS tenant
let corpTenantId = "72f988bf-86f1-41af-91ab-2d7cd011db47";   // CORP tenant (same as TORUS)
All('AgentDocumentDBState')
| where PreciseTimeStamp >= startTime and PreciseTimeStamp < endTime
| extend CustomWeek = bin(PreciseTimeStamp + 3d, 7d) - 3d
| join kind=leftouter (
    cluster("customerdomrptwus3prod.westus3.kusto.windows.net").database("customerdomdata").
    Product360CustomerSubscriptions
    | project CloudCustomerName, CloudCustomerDisplayName, ServiceGroupOid, ServiceGroupName, FriendlySubscriptionName, TenantDisplayName, IsFraudIdentified, CurrentSubscriptionStatus, OfferName, OfferType, BillingType, SubscriptionId, TenantId
) on $left.subscriptionId == $right.SubscriptionId
| where provisioningState == "Succeeded"
// Include AME, PME, TORUS, and CORP tenants
| where TenantId in (ameTenantId, pmeTenantId, torusTenantId, corpTenantId)
| where OfferType contains "Internal"
// Exclude amandas and balam service groups for CORP/TORUS tenant
| where not (TenantId == corpTenantId and (ServiceGroupName contains "amandas" or ServiceGroupName contains "balam"))
| summarize 
    UniqueAgents = dcount(agentName),
    UniqueSubscriptions = dcount(subscriptionId),
    UniqueServiceGroups = dcount(ServiceGroupName)
by CustomWeek
| order by CustomWeek asc
