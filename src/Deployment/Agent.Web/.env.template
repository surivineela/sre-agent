# Configuration for build_and_push_deploy.sh
# Copy this file to .env and fill in the values

# Azure Container Registry URL (required)
ACR_REGISTRY="your-registry.azurecr.io"

# Image name (optional, default: agent-web)
# IMAGE_NAME="agent-web"

ENVIRONMENT_NAME="sre-agent-aca"

# Azure Resource Group, it's better to align with your private stamp resource group
RESOURCE_GROUP="mltest"

REGION="australiaeast"

ACR="your-acr-name"

PRIVATE_STAMP_ENV_PREFIX="jianbosun"

# Managed Identity for AppConfig connection
MI_CLIENT_ID="your-mi-client-id"
MI_TENANT_ID=""
