# Use the official .NET 9 runtime image to run the app
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
COPY . .

RUN apt-get update && \
    apt-get install -y apt-transport-https ca-certificates curl gnupg lsb-release git curl && \
    mkdir -p /etc/apt/keyrings && \
    curl -sLS https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor | tee /etc/apt/keyrings/microsoft.gpg > /dev/null && \
    chmod go+r /etc/apt/keyrings/microsoft.gpg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    node -v && npm -v && \
    echo 'Installing MCP CLI (@azure/mcp@0.5.11)...' && \
    (npm install -g @azure/mcp@0.5.11 || (echo 'Fallback: cloning repo'; git clone --depth 1 --branch v0.5.11 https://github.com/Azure/mcp /tmp/mcp && cd /tmp/mcp && npm ci && npm install -g .)) && \
    npm cache clean --force && rm -rf /var/lib/apt/lists/* /tmp/mcp   # Install Node.js 20 (required for MCP CLI)

# Set environment variables (optional)
ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV AppSettings__Core__External__IncidentManagement__Type=Icm
ENV AppSettings__Core__External__IncidentManagement__ICMAPI__ReadOnly=true
ENV AppSettings__Core__External__IncidentManagement__AutomatedRCA__Enabled=true
ENV AppSettings__Core__Experimental__EnableModeSwitch=true
# TODO: This URL requires SAW access. Once we got cross-tenant access, revisit this.
ENV AppSettings__Core__External__IncidentManagement__AutomatedRCA__WebBaseUrl=https://aka.ms/sreagent-prefixonly#view/Microsoft_Azure_PaasServerless/FirstPartyAgentFrameBlade.ReactView/agentDisplayName/FunctionsRCA%20agent/agentUrl/https%3A%2F%2Ffunctionsrca-001--06ae8b31.3d3f9aed.eastus2.azuresre.ai
ENV AGENT_TYPE_NAME=RCARouterAgent

# Expose the port the app runs on
EXPOSE 8080

# Run the application
ENTRYPOINT ["dotnet", "Agent.Web.dll", "--session"]
