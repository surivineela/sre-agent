@page "/"
@using Agent.Core.Models
@using FirstPartyAgent.Models
@using FirstPartyAgent.Core.Helpers
@using FirstPartyAgent.Core.Models
@using FirstPartyAgent.Core.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IChatService ChatService
@inject IJSRuntime JS

<!-- Include Ace Editor -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.4.12/ace.js"></script>
<script>
    window.initializeJsonEditor = function (elementId, jsonContent) {
    var editor = ace.edit(elementId);
    editor.setTheme("ace/theme/monokai");
    editor.session.setMode("ace/mode/json");
    editor.setValue(jsonContent, -1); // -1 moves cursor to start
    window.jsonEditor = editor;
    };

    window.getJsonEditorContent = function (elementId) {
    return ace.edit(elementId).getValue();
    };
</script>

<!-- Dropdown for selecting an agent -->
<div class="agent-selector">
    <label for="agentDropdown">Select Agent:</label>
    <select id="agentDropdown" value="@SelectedAgent" @onchange="OnAgentChanged">
        @foreach (var agent in AvailableAgents)
        {
            <option value="@agent">@agent</option>
        }
    </select>
</div>

<div class="chat-container">
    <div class="messages-container" @ref="messagesDiv">
        @foreach (var message in messages)
        {
            <div class="message @(message.IsUser ? "user-message" : "assistant-message")">
                <div class="message-content">
                    @((MarkupString)message.Message)
                </div>
                <div class="message-timestamp">
                    @message.Timestamp.ToString("HH:mm")
                </div>
            </div>
        }
        @if (isTyping)
        {
            <div class="message assistant-message">
                <div class="message-content">
                    <span class="typing-animation">
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                    </span>
                </div>
                <div class="message-timestamp">@DateTime.Now.ToString("HH:mm")</div>
            </div>
        }
    </div>

    <div class="chat-input">
        <form @onsubmit="HandleSubmit">
            <textarea rows="1"
            @bind="currentMessage"
            @bind:event="oninput"
            placeholder="Type a message..."
            @onkeypress="HandleKeyPress"
            @ref="textAreaRef">
            </textarea>
            <button type="submit" disabled="@string.IsNullOrWhiteSpace(currentMessage)">
                <i class="bi bi-send-fill"></i>
            </button>
        </form>
    </div>
</div>

@code {
    private ElementReference messagesDiv;
    private ElementReference textAreaRef;
    private string currentMessage = "";
    private List<ChatMessage> messages = new();
    private bool isTyping = false;
    private List<string> AvailableAgents = AgentFinder.ListAgentModes();
    private string SelectedAgent = string.Empty;

    private string sessionId = Guid.NewGuid().ToString();

    protected override void OnInitialized()
    {
        // Optionally set a default agent if available.
        if (AvailableAgents.Any())
        {
            SelectedAgent = AvailableAgents.First();
        }
    }

    private async Task OnAgentChanged(ChangeEventArgs e)
    {
        var newAgent = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(newAgent))
        {
            return;
        }

        // If the agent is changing and there are existing messages, confirm with the user.
        if (newAgent != SelectedAgent && messages.Any())
        {
            bool confirmSwitch = await JS.InvokeAsync<bool>("confirm", "Switching agents will delete the current chat. Do you want to proceed?");
            if (confirmSwitch)
            {
                SelectedAgent = newAgent;
                messages.Clear();
            }
            // If user cancels, do nothing so the selection remains unchanged.
        }
        else
        {
            SelectedAgent = newAgent;
        }
        sessionId = Guid.NewGuid().ToString();
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(currentMessage))
            return;

        var userMessage = new ChatMessage
            {
                Message = currentMessage,
                IsUser = true
            };

        messages.Add(userMessage);
        var tempMessage = currentMessage;
        currentMessage = "";

        await ScrollToBottom();

        try
        {
            isTyping = true;
            StateHasChanged();

            var messageRequest = new MessageRequestBody()
                {
                    Sender = "User",
                    Message = tempMessage,
                    AgentMode = SelectedAgent,
                    SessionId = sessionId,
                };
            var response = await ChatService.ProcessMessageAsync(messageRequest);
            isTyping = false;
            messages.Add(response);
            await ScrollToBottom();
        }
        catch
        {
            isTyping = false;
            messages.Add(new ChatMessage
                {
                    Message = "Sorry, there was an error processing your request.",
                    IsUser = false
                });
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await HandleSubmit();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottom();
        }
        await JS.InvokeVoidAsync("autoAdjustHeight", textAreaRef);
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("scrollToBottom", messagesDiv);
        }
        catch
        {
            // Handle any potential JS interop errors
        }
    }
}
