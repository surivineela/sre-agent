{
  "$schema": "https://ev2schema.azure.net/schemas/2020-04-01/RegionAgnosticServiceModel.json",
  "contentVersion": "1.0.0",
  "serviceMetadata": {
    "displayName": "SRE Agent Extension Service",
    "serviceIdentifier": "{{SERVICE_IDENTIFIER}}",
    "serviceGroup": "{{SERVICE_GROUP}}",
    "environment": "$config(environment)",
    "tenantId": "$config(deploymentTenantId)"
  },
  "serviceResourceGroupDefinitions": [
    {
      "name": "AgentExtensions",
      "subscriptionKey": "$config(subscriptionKey)",
      "azureResourceGroupName": "$config(resourceGroup)",
      "scopeTags": [
        {
          "name": "SREAgent"
        }
      ],       
      "serviceResourceDefinitions": [
        {
          "name": "AgentExtension",
          "composedOf": {
            "arm": {
              "templatePath": "ArmTemplates/sreagentContainerAppsExtension.json",
              "parametersPath": "ArmTemplates/sreagentContainerAppsExtension.parameters.json"
            }
          }
        }
      ]
    }
  ]
}