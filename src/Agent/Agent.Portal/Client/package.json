{
  "name": "agent-portal-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite build --config vite.config.unoptimized.ts",
    "watch": "vite --config vite.config.unoptimized.ts",
    "lint": "eslint",
    "preview": "vite preview",
    "test": "vitest run",
    "extract:loc": "formatjs extract \"**/*.{ts,tsx}\" --ignore \"**/*.{d,test,spec}.{ts,tsx}\" --out-file src/src/Strings/extracted/strings.json --format ./src/src/Strings/format.js",
    "compile:loc": "formatjs compile-folder --ast --format ./src/src/Strings/format.js \"src/src/Strings/extracted\" \"src/src/Strings/compiled\" ",
    "prepare": "cd ../../../../ && husky src/Agent/Agent.Portal/Client/.husky || true"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "npm run extract:loc",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fluentui/react-components": "^9.68.3",
    "@fluentui/react-icons": "^2.0.307",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-intl": "^7.1.11",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@formatjs/cli": "^6.7.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.33.0",
    "eslint-plugin-formatjs": "^5.4.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-mkcert": "^1.17.8",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
