let fromDate = datetime(##fromDate##);
let toDate = datetime(##toDate##);
let revisionName = "##revisionName##";
let region = "##region##";
SystemLogs
| where TIMESTAMP between (fromDate .. toDate)
| where LegionEnvironmentName == region
| where PodName has revisionName
| where severityText == "Error"
| order by TIMESTAMP desc