let region = "##region##";
let managedClusterName = "##managedClusterName##";
let fromDate = datetime(##fromDate##);
let toDate = datetime(##toDate##);
// Check for specific authentication issues in ExternalAuthEvents
let authFailureCount = toscalar(
    ExternalAuthEvents
    | where PreciseTimeStamp between (fromDate .. toDate)
    | where EnvironmentName contains managedClusterName
    | where (
        (msg contains "could not detect auth code in request" and
        msg contains "redirecting to https://login.microsoftonline.com/") or
        msg contains "missing x-envoy-external-address header" or
        (msg contains "request to 'https://" and 
        msg contains ".ext.azurecontainerapps.dev/sso/state' completed with status '200'")
    )
    | count
);
// Return only the auth issue count
print AuthFailureCount = authFailureCount
| project AuthFailureCount
