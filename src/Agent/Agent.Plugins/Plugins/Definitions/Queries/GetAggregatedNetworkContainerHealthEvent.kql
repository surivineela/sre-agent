let fromTime = datetime("##fromDate##");
let toTime = datetime("##toDate##");
let networkContainerID = "##networkContainerID##";
cluster("aznwsdn").database("aznwmds").AggregatedNcHealthEvent
| where TIMESTAMP between (toTime-30d .. toTime)
| where OwningServiceInstanceId == "Microsoft.App"
| where NcId == networkContainerID
| summarize min(healthEventTime), max(healthEventTime) by NcId, VnetId, ContainerId,OwnDsMappingsStatus, CustomerAddress,HealthState,NodeId
| project StartTime=min_healthEventTime,EndTime=max_healthEventTime,NetworkContainerID=NcId,ContainerId,NodeId,OwnDsMappingsStatus,NodeIP=CustomerAddress,HealthStatus=HealthState
