let queryFrom = datetime("##fromDate##");
let queryTo = datetime("##toDate##");
let customerSubscriptionId = "##customerSubscriptionId##";
let customerEnvironmentName = "##managedEnvironmentName##";

// Base filtered table
let BaseData = ManagedEnvironmentDBState
| where TIMESTAMP between (queryFrom .. queryTo)
| where isempty(customerSubscriptionId) or subscription =~ customerSubscriptionId
| where isempty(customerEnvironmentName) or environmentName =~  customerEnvironmentName
;

// Wrapper function for reuse
let TrackChanges = (data: (ComponentType: string, PreciseTimeStamp: datetime, Content: string)) {
    data
    | order by PreciseTimeStamp asc
    | where isnotempty(Content) and Content != ""
    | extend PreviousContent = prev(Content)
    | extend SessionIndex = row_cumsum(iff(Content != PreviousContent, 1, 0))
    | summarize StartTime = min(PreciseTimeStamp), EndTime = max(PreciseTimeStamp) by Content, SessionIndex, ComponentType
    | serialize 
    | extend PreviousContent = prev(Content)
    | extend ChangeStatus = iff(SessionIndex == 1, "No change", "Change")
    | where SessionIndex > 1 // focus only on change
    | project StartTime, EndTime, ComponentType, Value=Content, ChangeStatus, PreviousValue=PreviousContent
    | order by StartTime asc
};

// Version-related columns
let BuildVersionData = BaseData 
| where isnotempty(buildVersion)
| extend ComponentType = "ACA Control plane Build Version"
| project ComponentType, PreciseTimeStamp, Content = buildVersion;

let AKSVersionData = BaseData 
| where isnotempty(kubernetesVersion)
| extend ComponentType = "AKS Version"
| project ComponentType, PreciseTimeStamp, Content = kubernetesVersion;

let ChartVersionData = BaseData
| where isnotempty(chartVersion)
| extend ComponentType = "Chart Version"
| project ComponentType, PreciseTimeStamp, Content = chartVersion;

let VKChartVersionData = BaseData
| where isnotempty(vkChartVersion)
| extend ComponentType = "VK Chart Version"
| project ComponentType, PreciseTimeStamp, Content = vkChartVersion;

let TargetACAMChartVersionData = BaseData
| where isnotempty(targetACAMChartVersion)
| extend ComponentType = "Target ACAM Chart Version"
| project ComponentType, PreciseTimeStamp, Content = targetACAMChartVersion;

// Configuration
let IsLegionEnabledData = BaseData
| extend ComponentType = "Is Legion Enabled"
| project ComponentType, PreciseTimeStamp, Content = tostring(isLegionEnabled);

let HasWorkloadProfilesData = BaseData
| extend ComponentType = "Has Workload Profiles"
| project ComponentType, PreciseTimeStamp, Content = tostring(hasWorkloadProfiles);

let HasCustomerVnetForEnvData = BaseData
| extend ComponentType = "Has Customer VNet For Env"
| project ComponentType, PreciseTimeStamp, Content = tostring(hasCustomerVnetForEnv);

let HasCustomerVnetForClusterData = BaseData
| extend ComponentType = "Has Customer VNet For Cluster"
| project ComponentType, PreciseTimeStamp, Content = tostring(hasCustomerVnetForCluster);

let HasPrivateEndpointsData = BaseData
| extend ComponentType = "Has Private Endpoints"
| project ComponentType, PreciseTimeStamp, Content = tostring(hasPrivateEndpoints);

let ManagedClusterNameData = BaseData
| extend ComponentType = "Managed Cluster Name"
| project ComponentType, PreciseTimeStamp, Content = managedClusterName;

let CustomHelmValuesData = BaseData
| extend ComponentType = "Custom Helm Values"
| project ComponentType, PreciseTimeStamp, Content = customHelmValues;

let PublicNetworkAccessData = BaseData
| extend ComponentType = "Public Network Access"
| project ComponentType, PreciseTimeStamp, Content = tostring(publicNetworkAccess);

let HasMaintenanceConfigData = BaseData
| extend ComponentType = "Has Maintenance Configuration"
| project ComponentType, PreciseTimeStamp, Content = tostring(hasMaintenanceConfiguration);

let QuotaLimitData = BaseData
| extend ComponentType = "Quota Limit"
| project ComponentType, PreciseTimeStamp, Content = tostring(quotaLimit);

let IngressIPData = BaseData
| extend ComponentType = "Ingress IP"
| project ComponentType, PreciseTimeStamp, Content = ingressIP;

let LoadBalancerIdData = BaseData
| extend ComponentType = "Load Balancer ID"
| project ComponentType, PreciseTimeStamp, Content = loadBalancerId;

let TierData = BaseData
| extend ComponentType = "AKS Pricing Tier"
| project ComponentType, PreciseTimeStamp, Content = tier;

// Final union of all change-tracked components
union 
    // Versions
    TrackChanges(BuildVersionData),
    TrackChanges(AKSVersionData),
    TrackChanges(ChartVersionData),
    TrackChanges(VKChartVersionData),
    TrackChanges(TargetACAMChartVersionData),
    // Configuration
    TrackChanges(IsLegionEnabledData),
    TrackChanges(HasWorkloadProfilesData),
    TrackChanges(HasCustomerVnetForClusterData),
    TrackChanges(HasCustomerVnetForEnvData),
    TrackChanges(HasPrivateEndpointsData),
    TrackChanges(ManagedClusterNameData),
    TrackChanges(CustomHelmValuesData),
    TrackChanges(PublicNetworkAccessData),
    TrackChanges(HasMaintenanceConfigData),
    TrackChanges(QuotaLimitData),
    TrackChanges(LoadBalancerIdData),
    TrackChanges(IngressIPData),
    TrackChanges(TierData)
| order by StartTime asc, ComponentType asc
