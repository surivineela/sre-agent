{
  "manifest_version": 3,
  "name": "SRE Agent Browser Extension",
  "version": "1.0.0",
  "description": "Connect your browser to SRE Agent for web automation",
  "key": "",
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "tabGroups",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://localhost:*/*",
      "https://127.0.0.1:*/*",
      "https://*.portal.azure.com/*",
      "https://*.azurecopilot.io/*",
      "https://*.azurecopilot-test.io/*",
      "https://*.azuresre.ai/*"
    ]
  },
  "background": {
    "service_worker": "lib/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SRE Agent Browser Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
