{
    "name": "agent-react",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build",
        "dev": "vite build --config vite.config.unoptimized.ts",
        "watch": "vite --config vite.config.unoptimized.ts",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest",
        "extract:loc": "formatjs extract \"**/*.{ts,tsx}\" --ignore \"**/*.{d,test,spec}.{ts,tsx}\" --out-file src/src/Strings/extracted/strings.json --format ./src/src/Strings/format.js",
        "compile:loc": "formatjs compile-folder --ast --format ./src/src/Strings/format.js \"src/src/Strings/extracted\" \"src/src/Strings/compiled\" ",
        "prepare": "cd ../../../../ && husky src/Agent/Agent.Web/Client/.husky || true"
    },
    "lint-staged": {
        "*.{js,ts,tsx}": [
            "npm run extract:loc",
            "eslint --cache --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "@dagrejs/dagre": "^1.1.4",
        "@fluentui-copilot/react-copilot": "^0.24.3",
        "@fluentui/azure-themes": "^8.6.128",
        "@fluentui/react": "^8.122.14",
        "@fluentui/react-charting": "^5.23.81",
        "@fluentui/react-components": "^9.61.6",
        "@fluentui/react-icons": "^2.0.292",
        "@fluentui/react-search": "^9.1.4",
        "@monaco-editor/react": "^4.7.0",
        "@tanstack/react-query": "^5.71.1",
        "@xyflow/react": "^12.5.5",
        "axios": "^1.8.4",
        "elkjs": "^0.10.0",
        "formik": "2.2.9",
        "html-to-image": "^1.11.13",
        "lodash": "^4.17.21",
        "mermaid": "^11.6.0",
        "monaco-editor": "^0.52.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-icons": "^5.5.0",
        "react-infinite-scroll-component": "^6.1.0",
        "react-intl": "^7.1.11",
        "react-markdown": "^10.1.0",
        "react-router": "^7.5.3",
        "react-router-dom": "^6.30.0",
        "recharts": "^2.15.3",
        "rehype-raw": "^7.0.0",
        "remark-gfm": "^4.0.1",
        "rxjs": "^6.4.0",
        "web-worker": "^1.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@formatjs/cli": "^6.6.4",
        "@testing-library/jest-dom": "6.6.3",
        "@testing-library/react": "16.3.0",
        "@types/lodash": "^4.17.16",
        "@types/react": "^18.3.20",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react-swc": "^3.8.0",
        "child_process": "^1.0.2",
        "chokidar-cli": "^3.0.0",
        "eslint": "^9.21.0",
        "eslint-plugin-formatjs": "^5.3.1",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "lint-staged": "^15.5.1",
        "prettier-plugin-organize-imports": "^4.1.0",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.24.1",
        "vite": "^6.2.0",
        "vite-plugin-mkcert": "^1.17.8",
        "vitest": "3.1.2"
    }
}
