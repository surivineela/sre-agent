{
  "name": "agent-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "set NODE_OPTIONS=--max-old-space-size=4096 && tsc -b && vite build",
    "dev": "vite build --mode development",
    "watch": "vite --mode development",
    "lint": "eslint",
    "preview": "vite preview",
    "test": "vitest run",
    "extract:loc": "formatjs extract \"**/*.{ts,tsx}\" --ignore \"**/*.{d,test,spec}.{ts,tsx}\" --out-file src/src/Strings/extracted/strings.json --format ./src/src/Strings/format.js",
    "compile:loc": "formatjs compile-folder --ast --format ./src/src/Strings/format.js \"src/src/Strings/extracted\" \"src/src/Strings/compiled\" ",
    "prepare": "cd ../../../../ && husky src/Agent/Agent.Web/Client/.husky || true",
    "refresh-creds": "artifacts-npm-credprovider && npm install"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "npm run extract:loc",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fluentui-contrib/react-tree-grid": "^0.3.1",
    "@fluentui-copilot/react-copilot": "^0.30.2",
    "@fluentui/azure-themes": "^8.6.128",
    "@fluentui/react": "^8.123.4",
    "@fluentui/react-calendar-compat": "^0.3.9",
    "@fluentui/react-charting": "^5.24.23",
    "@fluentui/react-charts": "^9.2.3",
    "@fluentui/react-components": "^9.72.4",
    "@fluentui/react-datepicker-compat": "^0.6.14",
    "@fluentui/react-icons": "^2.0.307",
    "@fluentui/react-search": "^9.3.3",
    "@fluentui/react-timepicker-compat": "^0.4.20",
    "@microsoft/signalr": "^8.0.7",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.85.0",
    "@xyflow/react": "^12.8.2",
    "axios": "^1.11.0",
    "elkjs": "^0.10.0",
    "emoji-regex-xs": "^2.0.1",
    "formik": "2.4.6",
    "html-to-image": "^1.11.13",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "mermaid": "^11.6.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-intl": "^7.1.11",
    "react-markdown": "^10.1.0",
    "react-router": "^7.5.3",
    "react-router-dom": "^6.30.0",
    "recharts": "^3.1.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.2",
    "rxjs": "^7.8.2",
    "yup": "^1.7.1",
    "@amplitude/unified": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@formatjs/cli": "^6.7.2",
    "@swc/core": "^1.11.29",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/lodash": "^4.17.16",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@playwright/test": "1.55.1",
    "eslint": "^9.33.0",
    "eslint-plugin-formatjs": "^5.4.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.5",
    "prettier-plugin-organize-imports": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": ">=7.1.11",
    "vite-plugin-mkcert": "^1.17.8",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}