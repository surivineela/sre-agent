          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[De betrouwbaarheid wordt berekend op basis van je agentprompt, beschikbare hulpprogramma's en chatinteracties. Klik op Vernieuwen voor AI-gestuurde aanbevelingen.]]></Val>
          </Tgt>
        </Str>
        <Disp Icon="Str" />
      </Item>
