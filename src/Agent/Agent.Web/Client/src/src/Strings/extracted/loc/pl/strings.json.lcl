      <Item ItemId=";sQZhm1" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[This list shows your extended agents, tools, and connectors organized by category. Create and manage sub-agents to extend your capabilities, add custom tools for specific tasks, and configure connectors to access external resources.]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[Ta lista zawiera rozszerzonych agentów, narzędzia i łączniki uporządkowane według kategorii. Twórz agentów podrzędnych i zarządzaj nimi, aby rozszerzać możliwości, dodawać niestandardowe narzędzia do określonych zadań i konfigurować łączniki w celu uzyskiwania dostępu do zasobów zewnętrznych.]]></Val>
          </Tgt>
        </Str>
        <Disp Icon="Str" />
      </Item>
