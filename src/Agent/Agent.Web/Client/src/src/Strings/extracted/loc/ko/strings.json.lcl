      <Item ItemId=";0Dhe75" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[Manage SQL servers and their security policies.]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
