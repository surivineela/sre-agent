      <Item ItemId=";0VuGey" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[This will overwrite your tool selections. Are you sure you want to continue?]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[Bu, araç seçimlerinizin üzerine yazacak. Devam etmek istediğinizden emin misiniz?]]></Val>
