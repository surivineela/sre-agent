      <Item ItemId=";aXGUvh" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[I'm your Azure SRE Agent and here to help you monitor your resources, investigate incidents, automate responses, and ensure your systems follow best practices for reliability, performance, and security.]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[Ben Azure SRE Aracınızım ve kaynaklarınızı izlemenize, olayları araştırmanıza, yanıtları otomatikleştirmenize ve sistemlerinizin güvenilirlik, performans ve güvenlik için en iyi uygulamaları izlemesini sağlamanıza yardımcı olmak için buradayım.]]></Val>
          </Tgt>
        </Str>
        <Disp Icon="Str" />
