      <Item ItemId=";AdnFH8" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The current consumption exceeds the new allocation, which will take effect next month. Until then, the agent will run only in the always-on flow. Chat and actions will be unavailable.]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[Konsumsi saat ini melebihi alokasi baru, yang akan berlaku bulan depan. Hingga saat itu, agen hanya akan berjalan dalam alur always-on. Obrolan dan tindakan tidak akan tersedia.]]></Val>
          </Tgt>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";AeWmvh" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[Lets you manage virtual machines, but not access to them, and not the virtual network or storage account they are connected to.]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[Memungkinkan Anda mengelola mesin virtual, tetapi tidak dapat mengaksesnya, dan tidak dapat mengakses jaringan virtual atau akun penyimpanan yang tersambung dengan mesin virtual.]]></Val>
          </Tgt>
        </Str>
        <Disp Icon="Str" />
      </Item>
