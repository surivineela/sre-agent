      <Item ItemId=";JRLN0D" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[With incident response plans, the agent chooses the tools it needs to manage common types of incidents. Custom response plans replace this capability by giving the agent specific instructions that you provide.]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[Dengan rencana respons insiden, agen memilih alat yang diperlukan untuk mengelola jenis insiden umum. Rencana respons kustom menggantikan kemampuan ini dengan memberi agen instruksi khusus yang Anda berikan.]]></Val>
          </Tgt>
        </Str>
        <Disp Icon="Str" />
