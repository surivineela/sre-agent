      <Item ItemId=";JRLN0D" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[With incident response plans, the agent chooses the tools it needs to manage common types of incidents. Custom response plans replace this capability by giving the agent specific instructions that you provide.]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[Az incidenselhárítási tervekkel az ügynök kiválasztja azokat az eszközöket, amelyekre a gyakori incidenstípusok kezeléséhez szüksége van. Az egyéni elhárítási tervek ezt a képességet helyettesítik azzal, hogy az ügynöknek az Ön által megadott konkrét utasításokat adják.]]></Val>
          </Tgt>
        </Str>
        <Disp Icon="Str" />
      </Item>
