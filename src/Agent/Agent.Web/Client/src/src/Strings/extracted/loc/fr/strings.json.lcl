        <Str Cat="Text">
          <Val><![CDATA[Define autonomous agents with custom instructions and capabilities]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[Définir des assistants autonomes avec des instructions et des fonctionnalités personnalisées]]></Val>
          </Tgt>
        </Str>
