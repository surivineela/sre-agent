{
  "AppSettings": {
    "EnvPrefix": "",
    "ManagedIdentityClientId": "",
    "ApplicationName": "Agent.Web",
    "Core": {
      "Azure": {
        "OpenSupportTickets": false,
        "AppInsights": {
          "ConnectionString": "dummy"
        },
        "Crawler": {
          "TenantId": "72f988bf-86f1-41af-91ab-2d7cd011db47",
          "MaxParallelism": 4096,
          "CrawlRoot": "/subscriptions/ea2aa16c-c257-4359-aaea-ff2b0f3b3d10",
          "IdentityClientId": ""
        }
      },
      "External": {
        "TeamsEndpoint": "",
        "GitHub": {
          "ClientId": "",
          "ClientSecret": "",
          "CallbackUrl": "",
          "PatOverride": "replace"
        }
      }
    }
  },
  "TeamsBot": {
    "AppId": "",
    "AppType": "UserAssignedMsi",
    "TenantId": ""
  },
  "Logging": {
    "LogGenAICalls": true,
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Agent.Tests": "Verbose",
        //"Agent.Graph.Crawler": "Debug" // Uncomment for crawler service logs
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] [Thread {ThreadId}] [{SourceContext}] {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "WithProcessId", "WithThreadId" ],
  }
}