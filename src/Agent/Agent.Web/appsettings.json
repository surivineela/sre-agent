{
  "AppSettings": {
    "EnvPrefix": "", 
    "ApplicationName": "Agent.Web",
    "Environment": "Development",

    "Core": {
      "Azure": {
        "OpenSupportTickets": false
      },
      "External": {
        "TeamsEndpoint": "",
        "GitHub": {
          "ClientId": "",
          "ClientSecret": "",
          "CallbackUrl": "",
          "PatOverride": "replace"
        }
      }
    }
  },
  "Logging": {
    "LogGenAICalls": true,
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Agent.Tests": "Verbose",
        //"Agent.Graph.Crawler": "Debug" // Uncomment for crawler service logs
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] [Thread {ThreadId}] [{SourceContext}] {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "WithProcessId", "WithThreadId" ],
  }
}
