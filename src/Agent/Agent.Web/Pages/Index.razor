@page "/"
@page "/{*path}"
@using Agent.Core.Models
@using System.Net.Http.Json
@using Agent.Core.Services
@using Agent.Web.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IAgentManager AgentManager
@inject IJSRuntime JS

<div class="chat-container">
    <!-- Header Controls -->
    <div class="chat-controls">
        <!-- Thread Selector Dropdown -->
        <!-- Thread Selector Dropdown -->
        <div>
            <div class="control-label">Session</div>
            <div class="custom-dropdown">
                <button type="button" class="custom-dropdown-toggle">
                    @GetCurrentThreadDisplay()
                </button>
                <div class="custom-dropdown-menu">
                    @foreach (var thread in threads)
                    {
                        <button class="custom-dropdown-item @(thread.Id == currentChatId ? "active" : "")"
                                @onclick="async () => await SelectThread(thread.Id)">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>@thread.Name</span>
                                <span class="badge bg-secondary">@thread.AgentType</span>
                            </div>
                            <div class="thread-metadata">
                                <small class="text-muted">Created: @thread.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</small>
                                <small class="text-muted">
                                    • Last message: @thread.LastMessageAt.ToLocalTime().ToString("MMM d, h:mm tt")
                                </small>
                                <small class="text-muted">
                                    • Agent Type: @thread.AgentType
                                </small>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT: Agent Selection + New Chat -->
        <div>
            <div class="control-label">Agent</div>
            <div class="d-flex align-items-center">
                <select @bind="CurrentPath" class="form-select" style="min-width: 200px;">
                    @foreach (var path in availablePaths)
                    {
                        <option value="@path">@FormatAgentName(path)</option>
                    }
                </select>
                <button class="btn btn-primary ms-2" type="button" @onclick="@(async () => {
                    Console.WriteLine("Button clicked - executing CreateNewThreadAndRefresh");
                    await CreateNewThreadAndRefresh();
                })">
                    <i class="bi bi-plus-lg me-1"></i> New Chat
                </button>
            </div>
        </div>
    </div>

    <div class="messages-container" @ref="messagesDiv">
        @if (!messages.Any() && !isTyping)
        {
            <div class="empty-chat">
                <div class="empty-chat-icon">
                    <i class="bi bi-chat-square-text"></i>
                </div>
                <h3>Start a new conversation</h3>
                <p>Send a message to begin chatting with the @FormatAgentName(currentPath)</p>
            </div>
        }
        else
        {
            @foreach (var message in messages)
            {
                <div class="message @(message.IsUser ? "user-message" : "assistant-message")">
                    <div class="markdown-content">
                        @((MarkupString)message.Message)
                    </div>
                    <div class="message-timestamp">@message.Timestamp.ToString("HH:mm")</div>
                </div>
            }

            @if (isTyping)
            {
                <div class="message assistant-message">
                    <div class="message-content">
                        <span class="typing-animation">
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                        </span>
                    </div>
                    <div class="message-timestamp">@DateTime.Now.ToString("HH:mm")</div>
                </div>
            }
        }
    </div>

    <!-- Chat Input -->
    <div class="chat-input">
        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
            <textarea rows="1"
                      @bind="currentMessage"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyPress"
                      placeholder="Type a message..."
                      @ref="textAreaRef">
            </textarea>
            <button type="submit" disabled="@(string.IsNullOrWhiteSpace(currentMessage))">
                <i class="bi bi-send-fill"></i>
            </button>
        </form>
    </div>
</div>

@code {
    private ElementReference messagesDiv;
    private ElementReference textAreaRef;
    private string currentMessage = "";
    private List<ChatMessage> messages = new();
    private bool isTyping = false;
    private string currentPath = "/";
    private List<string> availablePaths = new();
    private List<ChatThread> threads = new();
    private string? currentChatId;
    private bool hasError = false;
    private string errorMessage = "";

    [Parameter] public string? Path { get; set; }

    private string CurrentPath
    {
        get => currentPath;
        set
        {
            if (currentPath != value)
            {
                currentPath = value;
                // Call API to switch agent.
                _ = SwitchAgentAsync(currentPath, currentChatId ?? "");
                messages.Clear();
                StateHasChanged();
                Navigation.NavigateTo(currentPath);
                SaveCurrentSession();
            }
        }
    }

    private async Task SwitchAgentAsync(string path, string chatId)
    {
        try
        {
            Console.WriteLine($"Switching agent to path: {path}, chatId: {chatId}");
            var response = await Http.PostAsJsonAsync("/Chat/SwitchAgent", new { Path = path, ChatId = chatId });

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error switching agent: {response.StatusCode} - {error}");
                hasError = true;
                errorMessage = $"Failed to switch agent: {response.StatusCode}";
            }
            else
            {
                Console.WriteLine("Agent switched successfully");
                // If we have a thread ID, load its history
                if (!string.IsNullOrEmpty(chatId))
                {
                    await SetThreadAndLoadHistory(chatId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception switching agent: {ex.Message}");
            hasError = true;
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        Console.WriteLine($"HandleSubmit called with currentChatId: {currentChatId}");
        if (string.IsNullOrWhiteSpace(currentMessage))
        {
            Console.WriteLine("Message is empty, not submitting");
            return;
        }

        if (string.IsNullOrEmpty(currentChatId))
        {
            // If no thread is selected, create one first
            await CreateNewThreadAndRefresh();
            if (string.IsNullOrEmpty(currentChatId))
            {
                messages.Add(new ChatMessage
                    {
                        Message = "Unable to create a new thread. Please try again.",
                        IsUser = false,
                        Timestamp = DateTime.Now
                    });
                StateHasChanged();
                return;
            }
        }

        try
        {
            var userMessage = new ChatMessage { Message = currentMessage, IsUser = true, Timestamp = DateTime.Now };
            messages.Add(userMessage);
            var tempMessage = currentMessage;
            currentMessage = "";
            StateHasChanged();
            await ScrollToBottom();

            isTyping = true;
            StateHasChanged();

            // Call API to process message with the CURRENT thread ID
            var response = await Http.PostAsJsonAsync("/Chat/ProcessMessage", new { Message = tempMessage, ChatId = currentChatId });

            isTyping = false;
            StateHasChanged();

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error processing message: {response.StatusCode} - {error}");
                messages.Add(new ChatMessage
                    {
                        Message = $"Error processing your request. Status: {response.StatusCode}",
                        IsUser = false,
                        Timestamp = DateTime.Now
                    });
            }
            else
            {
                var chatResponse = await response.Content.ReadFromJsonAsync<ChatResponse>();
                if (chatResponse != null)
                {
                    // Check if the response is a placeholder message
                    if (chatResponse.Content == "The agent is processing your request...")
                    {
                        // If it's a placeholder, we need to poll for the real response
                        messages.Add(new ChatMessage
                        {
                            Message = "Processing your request...",
                            IsUser = false,
                            Timestamp = DateTime.Now
                        });
                        StateHasChanged();
                        
                        // Poll for the real response
                        await PollForResponse(chatResponse.ThreadId);
                    }
                    else
                    {
                        // If it's a real response, add it to the messages
                        messages.Add(new ChatMessage
                        {
                            Message = chatResponse.Content,
                            IsUser = false,
                            Timestamp = DateTime.Now
                        });
                        StateHasChanged();
                    }
                }
                else
                {
                    messages.Add(new ChatMessage
                    {
                        Message = "Received empty response from server.",
                        IsUser = false,
                        Timestamp = DateTime.Now
                    });
                    StateHasChanged();
                }
            }

            // Refresh threads list to update LastMessageAt
            await RefreshThreadsList();
            SaveCurrentSession();
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            isTyping = false;
            Console.WriteLine($"Exception processing message: {ex.Message}");
            messages.Add(new ChatMessage
                {
                    Message = $"Error processing your request: {ex.Message}",
                    IsUser = false,
                    Timestamp = DateTime.Now
                });
            await ScrollToBottom();
        }

        // Make sure textarea is cleared and resized
        await JS.InvokeVoidAsync("autoAdjustHeight", textAreaRef);
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        Console.WriteLine($"Key pressed: {e.Key}, ShiftKey: {e.ShiftKey}");
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            // Prevent the default action
            await HandleSubmit();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize dropdowns with Bootstrap JS
            await JS.InvokeVoidAsync("initializeCustomDropdowns");
            await LoadSavedSession();
            await ScrollToBottom();
        }
        await JS.InvokeVoidAsync("autoAdjustHeight", textAreaRef);
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("scrollToBottom", messagesDiv);
        }
        catch { }
    }

    private bool shouldRedirect = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("OnInitializedAsync called");
            availablePaths = AgentManager.GetAvailableSubAgents().ToList();
            var requestedPath = string.IsNullOrEmpty(Path) ? "/" : $"/{Path}";

            if (!availablePaths.Contains(requestedPath, StringComparer.OrdinalIgnoreCase) && requestedPath != "/")
            {
                shouldRedirect = true;
                return;
            }
            else
            {
                currentPath = requestedPath;
            }

            await RefreshThreadsList();

            // We'll load the saved session in OnAfterRenderAsync
            if (!threads.Any())
            {
                await CreateNewThreadAndRefresh();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in OnInitializedAsync: {ex.Message}");
            hasError = true;
            errorMessage = $"Initialization error: {ex.Message}";
        }
    }

    private async Task LoadSavedSession()
    {
        try
        {
            // Try to get saved session from localStorage
            var savedChatId = await JS.InvokeAsync<string>("loadChatId");
            var savedPath = await JS.InvokeAsync<string>("loadCurrentPath");

            Console.WriteLine($"Loaded saved session: ChatId={savedChatId}, Path={savedPath}");

            if (!string.IsNullOrEmpty(savedChatId))
            {
                // Check if this thread exists in our list
                var threadExists = threads.Any(t => t.Id == savedChatId);

                if (threadExists)
                {
                    currentChatId = savedChatId;

                    // If we also have a saved path, set it
                    if (!string.IsNullOrEmpty(savedPath) && availablePaths.Contains(savedPath))
                    {
                        currentPath = savedPath;
                    }

                    // Load the history for this thread
                    await SetThreadAndLoadHistory(currentChatId);
                    StateHasChanged();
                }
                else
                {
                    Console.WriteLine("Saved thread ID not found in threads list");
                    // If the thread doesn't exist, select the first one
                    if (threads.Any())
                    {
                        currentChatId = threads[0].Id;
                        await SetThreadAndLoadHistory(currentChatId);
                    }
                    else
                    {
                        // Create a new thread if none exist
                        await CreateNewThreadAndRefresh();
                    }
                }
            }
            else if (threads.Any())
            {
                // No saved thread, select the first one
                currentChatId = threads[0].Id;
                await SetThreadAndLoadHistory(currentChatId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading saved session: {ex.Message}");
            // Fall back to default behavior
            if (threads.Any() && string.IsNullOrEmpty(currentChatId))
            {
                currentChatId = threads[0].Id;
                await SetThreadAndLoadHistory(currentChatId);
            }
        }
    }

    private async Task SaveCurrentSession()
    {
        try
        {
            if (!string.IsNullOrEmpty(currentChatId))
            {
                Console.WriteLine($"Saving session: ChatId={currentChatId}, Path={currentPath}");
                await JS.InvokeVoidAsync("saveChatId", currentChatId);
                await JS.InvokeVoidAsync("saveCurrentPath", currentPath);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving session: {ex.Message}");
        }
    }

    private async Task RefreshThreadsList()
    {
        // Fetch threads and check the response
        var response = await Http.GetAsync("/Chat/GetThreads");
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Error getting threads: {response.StatusCode} - {error}");
            hasError = true;
            errorMessage = $"Failed to get threads: {response.StatusCode}";
        }
        else
        {
            try
            {
                threads = await response.Content.ReadFromJsonAsync<List<ChatThread>>() ?? new List<ChatThread>();
                // Sort threads by last message date descending (newest first)
                threads = threads.OrderByDescending(t => t.LastMessageAt).ToList();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Exception deserializing threads: {ex.Message}");
                hasError = true;
                errorMessage = $"Error parsing threads: {ex.Message}";
            }
        }
    }

    // Set current thread and load its history.
    private async Task SetThreadAndLoadHistory(string chatId)
    {
        try
        {
            if (string.IsNullOrEmpty(chatId))
            {
                Console.WriteLine("Warning: Empty chatId passed to SetThreadAndLoadHistory");
                return;
            }

            Console.WriteLine($"Setting thread and loading history: {chatId}");
            currentChatId = chatId;

            // Set the current thread
            var setResponse = await Http.PostAsJsonAsync("/Chat/SetThread", new { ChatId = chatId });
            if (!setResponse.IsSuccessStatusCode)
            {
                var error = await setResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"Error setting thread: {setResponse.StatusCode} - {error}");
                return;
            }

            // IMPORTANT: Pass the agent type in the request
            // Create a request message to add the custom header
            using var request = new HttpRequestMessage(HttpMethod.Get, $"/Chat/GetHistory?chatId={chatId}");
            
            // Extract the agent type from the current path
            string agentType = "Meta";
            if (!string.IsNullOrEmpty(currentPath) && currentPath != "/")
            {
                agentType = currentPath.TrimStart('/');
            }
            
            // Add agent type as a header
            request.Headers.Add("AgentType", agentType);
            Console.WriteLine($"Requesting history with agent type: {agentType}");
            
            // Send the request with the custom header
            var historyResponse = await Http.SendAsync(request);
                
            if (!historyResponse.IsSuccessStatusCode)
            {
                var error = await historyResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"Error getting history: {historyResponse.StatusCode} - {error}");
                messages = new List<ChatMessage>();
            }
            else
            {
                messages = await historyResponse.Content.ReadFromJsonAsync<List<ChatMessage>>() ?? new List<ChatMessage>();
                Console.WriteLine($"Loaded {messages.Count} messages for thread {chatId} with agent type {agentType}");
            }

            SaveCurrentSession();
            StateHasChanged();
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in SetThreadAndLoadHistory: {ex.Message}");
            messages = new List<ChatMessage>();
            StateHasChanged();
        }
    }

    private async Task CreateNewThreadAndRefresh()
    {
        try
        {
            Console.WriteLine("Creating new thread...");
            messages.Clear();
            StateHasChanged();

            // Call API to create a new thread
            var response = await Http.PostAsJsonAsync("/Chat/CreateThread", new { Path = currentPath, ChatId = "" });

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error creating thread: {response.StatusCode} - {error}");
                messages.Add(new ChatMessage
                    {
                        Message = $"Error creating new thread: {response.StatusCode}",
                        IsUser = false,
                        Timestamp = DateTime.Now
                    });
                StateHasChanged();
                return;
            }

            try
            {
                Console.WriteLine("Successfully created thread, parsing response...");

                // First try to deserialize to the thread response
                var threadResponse = await response.Content.ReadFromJsonAsync<CreateThreadResponse>();
                if (threadResponse != null && !string.IsNullOrEmpty(threadResponse.ChatId))
                {
                    currentChatId = threadResponse.ChatId;
                    Console.WriteLine($"Thread created successfully. ChatId from response: {currentChatId}");
                }
                else
                {
                    // Try to deserialize directly to a ChatThread
                    var thread = await response.Content.ReadFromJsonAsync<ChatThread>();
                    if (thread != null && !string.IsNullOrEmpty(thread.Id))
                    {
                        currentChatId = thread.Id;
                        Console.WriteLine($"Thread created successfully. ChatId from thread: {currentChatId}");
                    }
                    else
                    {
                        Console.WriteLine("Failed to parse thread response");
                        messages.Add(new ChatMessage
                            {
                                Message = "Failed to create thread. Invalid response format.",
                                IsUser = false,
                                Timestamp = DateTime.Now
                            });
                        StateHasChanged();
                        return;
                    }
                }

                // Refresh threads list
                await RefreshThreadsList();

                // Load the thread history (which should be empty for a new thread)
                await SetThreadAndLoadHistory(currentChatId);
                SaveCurrentSession();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Exception parsing thread response: {ex.Message}");
                messages.Add(new ChatMessage
                    {
                        Message = $"Error creating thread: {ex.Message}",
                        IsUser = false,
                        Timestamp = DateTime.Now
                    });
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in CreateNewThreadAndRefresh: {ex.Message}");
            messages.Add(new ChatMessage
                {
                    Message = $"Error: {ex.Message}",
                    IsUser = false,
                    Timestamp = DateTime.Now
                });
            StateHasChanged();
        }
    }

    private string GetCurrentThreadDisplay()
    {
        var currentThread = threads.FirstOrDefault(t => t.Id == currentChatId);
        return currentThread != null ? currentThread.Name : "Select Thread";
    }

    private async Task SelectThread(string chatId)
    {
        if (chatId != currentChatId)
        {
            Console.WriteLine($"Selecting thread: {chatId}");
            await SetThreadAndLoadHistory(chatId);
            StateHasChanged();
        }
    }

    private string FormatAgentName(string path)
    {
        var name = path.TrimStart('/');
        return string.IsNullOrWhiteSpace(name) ? "Meta Agent" : char.ToUpper(name[0]) + name[1..] + " Agent";
    }

    // Helper classes to match the controller responses
    private class CreateThreadResponse
    {
        public string ChatId { get; set; } = string.Empty;
    }

    private class ChatResponse
    {
        public string MessageId { get; set; } = "";
        public string Content { get; set; } = "";
        public string ThreadId { get; set; } = "";
    }

    // Helper method to poll for a response
    private async Task PollForResponse(string threadId)
    {
        try
        {
            // Poll for up to 60 seconds (15 attempts, 4 seconds apart)
            for (int i = 0; i < 15; i++)
            {
                // Wait 3 seconds between polls
                await Task.Delay(4000);
                
                // Get the latest messages
                var historyResponse = await Http.GetAsync($"/Chat/GetHistory?chatId={threadId}");
                if (historyResponse.IsSuccessStatusCode)
                {
                    var history = await historyResponse.Content.ReadFromJsonAsync<List<ChatMessage>>();
                    if (history != null && history.Any())
                    {
                        // Get the latest non-user message
                        var latestAgentMessage = history.Where(m => !m.IsUser).OrderByDescending(m => m.Timestamp).FirstOrDefault();
                        if (latestAgentMessage != null)
                        {
                            var processingMessage2 = messages.LastOrDefault(m => !m.IsUser && m.Message == "Processing your request...");
                            if (processingMessage2 != null)
                            {
                                int index = messages.IndexOf(processingMessage2);
                                if (index >= 0)
                                {
                                    messages[index] = latestAgentMessage;
                                    StateHasChanged();
                                    await ScrollToBottom();
                                    return;
                                }
                            }
                            else
                            {
                                // If we can't find the processing message, just add the new one
                                messages.Add(latestAgentMessage);
                                StateHasChanged();
                                await ScrollToBottom();
                                return;
                            }
                        }
                    }
                }
            }
            
            // If we get here, we timed out waiting for a response
            var processingMessage = messages.LastOrDefault(m => !m.IsUser && m.Message == "Processing your request...");
            if (processingMessage != null)
            {
                int index = messages.IndexOf(processingMessage);
                if (index >= 0)
                {
                    messages[index] = new ChatMessage
                    {
                        Message = "The agent did not respond in time. Please try again.",
                        IsUser = false,
                        Timestamp = DateTime.Now
                    };
                    StateHasChanged();
                    await ScrollToBottom();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error polling for response: {ex.Message}");
            var processingMessage = messages.LastOrDefault(m => !m.IsUser && m.Message == "Processing your request...");
            if (processingMessage != null)
            {
                int index = messages.IndexOf(processingMessage);
                if (index >= 0)
                {
                    messages[index] = new ChatMessage
                    {
                        Message = $"Error getting response: {ex.Message}",
                        IsUser = false,
                        Timestamp = DateTime.Now
                    };
                    StateHasChanged();
                    await ScrollToBottom();
                }
            }
        }
    }
}