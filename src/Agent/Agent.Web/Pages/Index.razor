@page "/"
@page "/{*path}"
@using Agent.Core.Models
@using Agent.Core.Models.Api.v1
@using System.Net.Http.Json
@using Agent.Core.Services
@using Markdig
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop.Implementation
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<div class="app-container">
    <!-- Main Content Area -->
    <div class="main-content" style="margin-top:-10px">
        <!-- Left Sidebar - Threads List -->
        <aside class="threads-sidebar">
            <div class="sidebar-header">
                <button class="btn btn-blue new-chat-button" @onclick="@(async () => await CreateNewThreadAndRefresh())">
                    <i class="bi bi-plus-lg"></i> New Thread
                </button>
            </div>

            <div class="threads-list">
                @foreach (var thread in threads)
                {
                    <div class="thread-item @(thread.Id == currentChatId ? "active" : "")"
                         @onclick="async () => await SelectThread(thread.Id)">
                         <!-- for backward compatibility, if no lastMessage saved, display title like before-->
                        <div class="thread-title">@(!string.IsNullOrEmpty(thread.LastMessage) ? thread.LastMessage : thread.Name)</div>
                        <div class="thread-metadata">
                            <span class="thread-created-at" title="Created on @thread.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")">
                                @thread.CreatedAt.ToLocalTime().ToString("MMM d")
                            </span>
                            <span class="thread-last-message" title="Last active on @thread.LastMessageAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")">
                                @thread.LastMessageAt.ToLocalTime().ToString("h:mm tt")
                            </span>
                        </div>
                    </div>
                }
            </div>

            <div class="sidebar-footer">
                <button class="btn btn-danger purge-button" @onclick="@(async () => await ShowPurgeConfirmation())">
                    <i class="bi bi-trash"></i> Purge All
                </button>
            </div>
        </aside>

        <!-- Main Chat Area -->
        <main class="chat-main">
            <!-- Chat Header -->
            <div class="chat-header">
                <h2>@GetCurrentThreadDisplay()</h2>
                <div class="chat-actions">
                    <button class="btn btn-icon" title="Download Messages" @onclick="DownloadMessages">
                        <i class="bi bi-download"></i>
                    </button>
                    <button class="btn btn-icon" title="Download All Orchestration Histories" @onclick="DownloadAllOrchestrationHistories">
                        <i class="bi bi-cloud-download"></i>
                    </button>
                </div>
            </div>

            <!-- Messages Container -->
            <div class="messages-container" @ref="messagesDiv">
                @if (!messages.Any() && !isTyping)
                {
                    <div class="empty-chat">
                        <div class="empty-chat-icon">
                            <i class="bi bi-chat-square-text"></i>
                        </div>
                        <h3>Start a new conversation</h3>
                        <p>Send a message to begin chatting with the @FormatAgentName(currentPath)</p>
                    </div>
                }
                else
                {
                    @foreach (var message in messages)
                    {
                        <div class="message @(message.IsUser ? "user-message" : "assistant-message")">
                            <div class="message-avatar">
                                <i class="@(message.IsUser ? "bi bi-person-circle" : "bi bi-robot")"></i>
                            </div>
                            <div class="message-content">
                                <div class="message-sender">
                                    @(message.IsUser ? "You" : FormatAgentName(currentPath))
                                </div>
                                <div class="markdown-content">
                                    @((MarkupString)message.FormattedMessage)
                                </div>
                                <div class="message-timestamp">@message.Timestamp.ToString("HH:mm")</div>
                            </div>
                        </div>
                    }

                    @if (isTyping)
                    {
                        <div class="message assistant-message">
                            <div class="message-avatar">
                                <i class="bi bi-robot"></i>
                            </div>
                            <div class="message-content">
                                <div class="message-sender">
                                    @FormatAgentName(currentPath)
                                </div>
                                <div class="typing-animation">
                                    <span class="typing-dot"></span>
                                    <span class="typing-dot"></span>
                                    <span class="typing-dot"></span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Chat Input -->
            <div class="chat-input-container">
                <form @onsubmit="HandleSubmit" @onsubmit:preventDefault class="chat-form">
                    <textarea rows="1"
                              @bind="currentMessage"
                              @bind:event="oninput"
                              @onkeydown="HandleKeyPress"
                              placeholder="Message the AI..."
                              @ref="textAreaRef"
                              class="chat-textarea">
                    </textarea>
                    <button type="submit" class="send-button" disabled="@(string.IsNullOrWhiteSpace(currentMessage))">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>
                <div class="input-footer">
                    <small>AI responses may not always be accurate. Consider checking important information.</small>
                </div>
            </div>
        </main>

        <!-- Right Sidebar - Actions Pane -->
        <aside class="actions-sidebar">
            <div class="actions-header">
                <h3>Actions</h3>
            </div>

            <div class="actions-content">
                @if (!string.IsNullOrEmpty(currentChatId) && actions.Any())
                {
                    @foreach (var action in actions)
                    {
                        <div class="action-card @GetActionStatusClass(action.Status)">
                            <i class="@GetActionIcon(action.Status)"></i>
                            <div class="action-content">
                                <span class="action-title">@action.Title</span>
                                <span class="action-timestamp">@action.TimeStamp.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                            </div>
                            <div class="action-status">
                                <span class="status-badge @action.Status.ToString().ToLower()">@action.Status</span>
                            </div>
                        </div>
                    }
                }
                else if (!string.IsNullOrEmpty(currentChatId))
                {
                    <div class="empty-actions">
                        <i class="bi bi-info-circle"></i>
                        <p>No actions available for this conversation.</p>
                    </div>
                }
                else
                {
                    <div class="empty-actions">
                        <i class="bi bi-info-circle"></i>
                        <p>Select a conversation to view available actions.</p>
                    </div>
                }
            </div>

            <div class="actions-footer">
                <span>Agent Type: @GetAgentTypeFromPath(currentPath)</span>
            </div>
        </aside>
    </div>

    <!-- Footer -->
    <footer class="app-footer">
        <div>Lightweight Tool Built for Internal Testing of SRE Agent</div>
    </footer>

    <!-- Confirmation Dialog -->
    @if (showPurgeConfirmation)
    {
        <div class="modal-overlay">
            <div class="confirmation-dialog">
                <div class="dialog-header">
                    <h4>Confirm Purge</h4>
                    <button class="btn-close" @onclick="CancelPurge"></button>
                </div>
                <div class="dialog-body">
                    <p>Are you sure you want to delete all conversations? This action cannot be undone.</p>
                </div>
                <div class="dialog-footer">
                    <button class="btn btn-secondary" @onclick="CancelPurge">Cancel</button>
                    <button class="btn btn-danger" @onclick="PurgeAllThreads">Delete All</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ElementReference messagesDiv;
    private ElementReference textAreaRef;
    private string currentMessage = "";
    private List<ChatMessage> messages = new();
    private bool isTyping = false;
    private string currentPath = "/";
    private List<ChatThread> threads = new();
    private string? currentChatId;
    private bool hasError = false;
    private string errorMessage = "";
    private bool showPurgeConfirmation = false;
    private List<Action> actions = new();

    private readonly MarkdownPipeline _markdownPipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .DisableHtml()
            .Build();

    [Parameter] public string? Path { get; set; }

    private string CurrentPath
    {
        get => currentPath;
        set
        {
            if (currentPath != value)
            {
                currentPath = value;
                // Call API to switch agent.
                _ = SwitchAgentAsync(currentPath, currentChatId ?? "");
                messages.Clear();
                StateHasChanged();
                Navigation.NavigateTo(currentPath);
                SaveCurrentSession();
            }
        }
    }

    private async Task DownloadMessages()
    {
        try
        {
            // Format the messages for download
            string content = "# Conversation: " + GetCurrentThreadDisplay() + "\n\n";

            foreach (var message in messages)
            {
                string sender = message.IsUser ? "You" : FormatAgentName(currentPath);
                content += $"## {sender} - {message.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")}\n\n";
                content += message.Message + "\n\n";
            }

            // Generate a filename based on the conversation title and date
            string fileName = $"{GetCurrentThreadDisplay().Replace(" ", "_")}_{DateTime.Now.ToString("yyyyMMdd_HHmmss")}.md";

            // Create a data URI for the file download
            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(content);
            string base64 = Convert.ToBase64String(bytes);
            string dataUrl = $"data:text/markdown;base64,{base64}";

            // Trigger the download
            await JS.InvokeVoidAsync("downloadFile", fileName, dataUrl);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading messages: {ex.Message}");
        }
    }

    private async Task DownloadAllOrchestrationHistories()
    {
        try
        {
            var userMessage = new ChatMessage
                {
                    Message = "Downloading all orchestration chat histories...",
                    FormattedMessage = ApplyMarkdown("Downloading all orchestration chat histories..."),
                    IsUser = false,
                    Timestamp = DateTime.Now
                };
            messages.Add(userMessage);
            StateHasChanged();

            var client = HttpClientFactory.CreateClient("Razor");
            var response = await client.GetAsync("/api/v1/ChatHistory/all");

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error downloading orchestration histories: {response.StatusCode} - {error}");

                messages.Add(new ChatMessage
                    {
                        Message = $"Error downloading orchestration histories: {response.StatusCode}",
                        FormattedMessage = ApplyMarkdown($"Error downloading orchestration histories: {response.StatusCode}"),
                        IsUser = false,
                        Timestamp = DateTime.Now
                    });
                StateHasChanged();
                return;
            }

            var rawResponseContent = await response.Content.ReadAsStringAsync();
            var timestamp = DateTime.UtcNow.ToString("yyyyMMdd_HHmmss");

            var fileContent = await response.Content.ReadAsByteArrayAsync();
            var fileName = GetFileNameFromResponse(response) ?? $"orchestration_chat_histories_{timestamp}.json";

            string base64 = Convert.ToBase64String(fileContent);
            string dataUrl = $"data:application/json;base64,{base64}";

            await JS.InvokeVoidAsync("downloadFile", fileName, dataUrl);

            byte[] rawBytes = System.Text.Encoding.UTF8.GetBytes(rawResponseContent);
            string rawBase64 = Convert.ToBase64String(rawBytes);
            string rawDataUrl = $"data:text/plain;base64,{rawBase64}";
            string rawFileName = $"raw_response_{timestamp}.txt";

            await JS.InvokeVoidAsync("downloadFile", rawFileName, rawDataUrl);

            messages.RemoveAt(messages.Count - 1);
            messages.Add(new ChatMessage
                {
                    Message = $"Downloaded orchestration chat histories as {fileName} and raw response as {rawFileName}",
                    FormattedMessage = ApplyMarkdown($"Downloaded orchestration chat histories as {fileName} and raw response as {rawFileName}"),
                    IsUser = false,
                    Timestamp = DateTime.Now
                });
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading orchestration histories: {ex.Message}");
            messages.Add(new ChatMessage
                {
                    Message = $"Error downloading orchestration histories: {ex.Message}",
                    FormattedMessage = ApplyMarkdown($"Error downloading orchestration histories: {ex.Message}"),
                    IsUser = false,
                    Timestamp = DateTime.Now
                });
            StateHasChanged();
        }
    }

    private string? GetFileNameFromResponse(HttpResponseMessage response)
    {
        if (response.Content.Headers.ContentDisposition != null)
        {
            return response.Content.Headers.ContentDisposition.FileName?.Trim('"');
        }
        return null;
    }

    private async Task SwitchAgentAsync(string path, string chatId)
    {
        // Placeholder for future implementation
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(currentMessage))
        {
            return;
        }

        if (string.IsNullOrEmpty(currentChatId))
        {
            // If no thread is selected, create one first
            await CreateNewThreadAndRefresh();
            if (string.IsNullOrEmpty(currentChatId))
            {
                AddAssistantMessage("Unable to create a new thread. Please try again.");
                return;
            }
        }

        try
        {
            var userMessage = new ChatMessage
                {
                    Message = currentMessage,
                    FormattedMessage = ApplyMarkdown(currentMessage),
                    IsUser = true,
                    Timestamp = DateTime.Now
                };
            messages.Add(userMessage);
            var tempMessage = currentMessage;
            currentMessage = "";
            StateHasChanged();
            await ScrollToBottom();

            isTyping = true;
            StateHasChanged();

            // Process message using ThreadsApiController
            if (Guid.TryParse(currentChatId, out Guid threadId))
            {
                // Create a message in the thread using ThreadsApiController
                var createMessageRequest = new CreateMessageRequest(
                    text: tempMessage,
                    userId: "web-client-user",
                    displayName: "Web Client User"
                );

                var client = HttpClientFactory.CreateClient("Razor");
                var response = await client.PostAsJsonAsync($"/api/v1/Threads/{threadId}/messages", createMessageRequest);

                isTyping = false;
                StateHasChanged();

                if (!response.IsSuccessStatusCode)
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"Error processing message: {response.StatusCode} - {error}");
                    AddAssistantMessage($"Error processing your request. Status: {response.StatusCode}");
                }
                else
                {
                    // Message has been created, now we need to poll for the AI response
                    AddAssistantMessage("Processing your request...");

                    // Poll for the real response
                    await PollForResponse(threadId.ToString());
                }
            }
            else
            {
                AddAssistantMessage("Invalid thread ID format.");
            }

            // Refresh threads list to update LastMessageAt
            await RefreshThreadsList();
            SaveCurrentSession();
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            isTyping = false;
            Console.WriteLine($"Exception processing message: {ex.Message}");
            AddAssistantMessage($"Error processing your request: {ex.Message}");
            await ScrollToBottom();
        }

        // Make sure textarea is cleared and resized
        await JS.InvokeVoidAsync("autoAdjustHeight", textAreaRef);
    }

    private void AddAssistantMessage(string text)
    {
        messages.Add(new ChatMessage
            {
                Message = text,
                FormattedMessage = ApplyMarkdown(text),
                IsUser = false,
                Timestamp = DateTime.Now
            });
        StateHasChanged();
    }

    private string ApplyMarkdown(string text)
    {
        return Markdown.ToHtml(text, _markdownPipeline);
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await HandleSubmit();
        }
    }

    private JSObjectReference? _layoutManager;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Initialize layout manager
                _layoutManager = await JS.InvokeAsync<JSObjectReference>("initializeChatLayout");

                // Load saved session data
                await LoadSavedSession();

                // Scroll to bottom of messages
                await ScrollToBottom();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in OnAfterRenderAsync: {ex.Message}");
            }
        }

        // Auto-adjust textarea height
        await JS.InvokeVoidAsync("autoAdjustHeight", textAreaRef);
    }

    // Be sure to dispose the JS reference when component is disposed
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_layoutManager != null)
            {
                await _layoutManager.DisposeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error disposing layout manager: {ex.Message}");
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("scrollToBottom", messagesDiv);
        }
        catch { /* Ignore scroll errors */ }
    }

    private bool shouldRedirect = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var requestedPath = string.IsNullOrEmpty(Path) ? "/" : $"/{Path}";
            currentPath = requestedPath;

            await RefreshThreadsList();

            // We'll load the saved session in OnAfterRenderAsync
            if (!threads.Any())
            {
                await CreateNewThreadAndRefresh();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in OnInitializedAsync: {ex.Message}");
            hasError = true;
            errorMessage = $"Initialization error: {ex.Message}";
        }
    }

    private async Task LoadSavedSession()
    {
        try
        {
            // Try to get saved session from localStorage
            var savedChatId = await JS.InvokeAsync<string>("loadChatId");
            var savedPath = await JS.InvokeAsync<string>("loadCurrentPath");

            if (!string.IsNullOrEmpty(savedChatId))
            {
                // Check if this thread exists in our list
                var threadExists = threads.Any(t => t.Id == savedChatId);

                if (threadExists)
                {
                    currentChatId = savedChatId;

                    // Load the history for this thread
                    await SetThreadAndLoadHistory(currentChatId);
                }
                else
                {
                    // If the thread doesn't exist, select the first one
                    if (threads.Any())
                    {
                        currentChatId = threads[0].Id;
                        await SetThreadAndLoadHistory(currentChatId);
                    }
                    else
                    {
                        // Create a new thread if none exist
                        await CreateNewThreadAndRefresh();
                    }
                }
            }
            else if (threads.Any())
            {
                // No saved thread, select the first one
                currentChatId = threads[0].Id;
                await SetThreadAndLoadHistory(currentChatId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading saved session: {ex.Message}");
            // Fall back to default behavior
            if (threads.Any() && string.IsNullOrEmpty(currentChatId))
            {
                currentChatId = threads[0].Id;
                await SetThreadAndLoadHistory(currentChatId);
            }
        }
    }

    private async Task SaveCurrentSession()
    {
        try
        {
            if (!string.IsNullOrEmpty(currentChatId))
            {
                await JS.InvokeVoidAsync("saveChatId", currentChatId);
                await JS.InvokeVoidAsync("saveCurrentPath", currentPath);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving session: {ex.Message}");
        }
    }

    private async Task RefreshThreadsList()
    {
        try
        {
            // Fetch threads from ThreadsApiController
            var client = HttpClientFactory.CreateClient("Razor");
            var response = await client.GetAsync("/api/v1/Threads");
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error getting threads: {response.StatusCode} - {error}");
                hasError = true;
                errorMessage = $"Failed to get threads: {response.StatusCode}";
            }
            else
            {
                try
                {
                    var options = new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true,
                            Converters = { new JsonStringEnumConverter() }
                        };
                    var apiResponse = await response.Content.ReadFromJsonAsync<ThreadsResponse>(options);
                    var threadsList = apiResponse?.Value;
                    if (threadsList != null)
                    {
                        // Convert API Thread objects to ChatThread objects for UI
                        threads = threadsList.Select(t => new ChatThread
                            {
                                Id = t.Id.ToString(),
                                Name = t.Title,
                                CreatedAt = t.CreatedTimestamp,
                                LastMessageAt = t.ModifiedTimestamp,
                                LastMessage = t.LastMessage?.Text,
                                AgentType = GetAgentTypeFromPath(currentPath)
                            }).ToList();

                        // Sort threads by last message date descending (newest first)
                        threads = threads.OrderByDescending(t => t.LastMessageAt).ToList();
                        StateHasChanged();
                    }
                    else
                    {
                        Console.WriteLine("Received empty threads response");
                        threads = new List<ChatThread>();
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Exception deserializing threads: {ex.Message}");
                    hasError = true;
                    errorMessage = $"Error parsing threads: {ex.Message}";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in RefreshThreadsList: {ex.Message}");
            hasError = true;
            errorMessage = $"Error refreshing threads: {ex.Message}";
        }
    }

    private string GetAgentTypeFromPath(string path)
    {
        if (string.IsNullOrEmpty(path) || path == "/")
            return "Meta";

        return path.TrimStart('/');
    }

    // Set current thread and load its history
    private async Task SetThreadAndLoadHistory(string chatId)
    {
        try
        {
            if (string.IsNullOrEmpty(chatId))
            {
                Console.WriteLine("Warning: Empty chatId passed to SetThreadAndLoadHistory");
                return;
            }

            currentChatId = chatId;

            if (Guid.TryParse(chatId, out Guid threadId))
            {
                // Get messages using ThreadsApiController
                var client = HttpClientFactory.CreateClient("Razor");
                var response = await client.GetAsync($"/api/v1/Threads/{threadId}/messages");
                if (!response.IsSuccessStatusCode)
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"Error getting messages: {response.StatusCode} - {error}");
                    messages = new List<ChatMessage>();
                }
                else
                {
                    var options = new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true,
                            Converters = { new JsonStringEnumConverter() }
                        };
                    var apiResponse = await response.Content.ReadFromJsonAsync<MessagesResponse>(options);
                    var messagesList = apiResponse?.Value;
                    if (messagesList != null)
                    {
                        // Convert API Message objects to ChatMessage objects for UI
                        messages = messagesList.Select(m => new ChatMessage
                            {
                                Message = m.Text,
                            // Fix: Apply Markdown immediately when loading messages
                                FormattedMessage = Markdown.ToHtml(m.Text, _markdownPipeline),
                            // Fix: Properly determine if message is from user or assistant
                                IsUser = m.Author.Role == Role.User,
                                Timestamp = m.TimeStamp
                            }).ToList();

                        Console.WriteLine($"Loaded {messages.Count} messages for thread {chatId}");
                    }
                    else
                    {
                        messages = new List<ChatMessage>();
                    }
                }

                // Load actions for this thread
                await LoadActionsForThread(threadId);
            }
            else
            {
                Console.WriteLine("Invalid thread ID format");
                messages = new List<ChatMessage>();
            }

            SaveCurrentSession();
            StateHasChanged();
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in SetThreadAndLoadHistory: {ex.Message}");
            messages = new List<ChatMessage>();
            StateHasChanged();
        }
    }

    private async Task LoadActionsForThread(Guid threadId)
    {
        try
        {
            // Get actions using ThreadsApiController
            var client = HttpClientFactory.CreateClient("Razor");
            var response = await client.GetAsync($"/api/v1/Threads/{threadId}/actions");
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error getting actions: {response.StatusCode} - {error}");
                actions = new List<Action>();
            }
            else
            {
                var options = new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        Converters = { new JsonStringEnumConverter() }
                    };
                var apiResponse = await response.Content.ReadFromJsonAsync<ActionsResponse>(options);
                var actionsList = apiResponse?.Value;
                if (actionsList != null)
                {
                    actions = actionsList.ToList();
                    Console.WriteLine($"Loaded {actions.Count} actions for thread {threadId}");
                }
                else
                {
                    actions = new List<Action>();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in LoadActionsForThread: {ex.Message}");
            actions = new List<Action>();
        }
    }

    private async Task CreateNewThreadAndRefresh()
    {
        try
        {
            messages.Clear();
            StateHasChanged();

            // Create thread using ThreadsApiController
            var createThreadRequest = new CreateThreadRequest(
                startMessage: new CreateMessageRequest(
                    text: "Hi",
                    userId: "web-client-user",
                    displayName: "Web Client User"
                )
            );

            var client = HttpClientFactory.CreateClient("Razor");
            var response = await client.PostAsJsonAsync("/api/v1/threads", createThreadRequest);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error creating thread: {response.StatusCode} - {error}");
                AddAssistantMessage($"Error creating new thread: {response.StatusCode}");
                return;
            }

            try
            {
                // Parse the response according to the ThreadsApiController format
                var options = new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        Converters = { new JsonStringEnumConverter() }
                    };
                var thread = await response.Content.ReadFromJsonAsync<Thread>(options);
                if (thread != null && thread.Id != Guid.Empty)
                {
                    currentChatId = thread.Id.ToString();
                }
                else
                {
                    Console.WriteLine("Failed to parse thread response");
                    AddAssistantMessage("Failed to create thread. Invalid response format.");
                    return;
                }

                // Refresh threads list
                await RefreshThreadsList();

                // Load the thread history (which should be empty for a new thread)
                await SetThreadAndLoadHistory(currentChatId);
                SaveCurrentSession();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Exception parsing thread response: {ex.Message}");
                AddAssistantMessage($"Error creating thread: {ex.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in CreateNewThreadAndRefresh: {ex.Message}");
            AddAssistantMessage($"Error: {ex.Message}");
        }
    }

    private string GetCurrentThreadDisplay()
    {
        var currentThread = threads.FirstOrDefault(t => t.Id == currentChatId);
        return currentThread != null ? currentThread.Name : "New Conversation";
    }

    private async Task SelectThread(string chatId)
    {
        if (chatId != currentChatId)
        {
            await SetThreadAndLoadHistory(chatId);
        }
    }

    private string FormatAgentName(string path)
    {
        var name = path.TrimStart('/');
        return string.IsNullOrWhiteSpace(name) ? "Meta Agent" : char.ToUpper(name[0]) + name[1..] + " Agent";
    }

    private string GetActionStatusClass(ActionStatus status)
    {
        return status switch
        {
            ActionStatus.Pending => "status-pending",
            ActionStatus.InProgress => "status-inprogress",
            ActionStatus.Completed => "status-completed",
            ActionStatus.Failed => "status-failed",
            _ => string.Empty
        };
    }

    private string GetActionIcon(ActionStatus status)
    {
        return status switch
        {
            ActionStatus.Pending => "bi bi-clock",
            ActionStatus.InProgress => "bi bi-arrow-repeat",
            ActionStatus.Completed => "bi bi-check-circle",
            ActionStatus.Failed => "bi bi-exclamation-triangle",
            _ => "bi bi-question-circle"
        };
    }

    // Helper method to poll for a response
    private async Task PollForResponse(string threadId)
    {
        try
        {
            // Poll for up to 60 seconds (15 attempts, 4 seconds apart)
            for (int i = 0; i < 15; i++)
            {
                // Wait 4 seconds between polls
                await Task.Delay(4000);

                if (Guid.TryParse(threadId, out Guid parsedThreadId))
                {
                    // Get the latest messages using ThreadsApiController
                    var client = HttpClientFactory.CreateClient("Razor");
                    var response = await client.GetAsync($"/api/v1/threads/{parsedThreadId}/messages");
                    if (response.IsSuccessStatusCode)
                    {
                        var options = new JsonSerializerOptions
                            {
                                PropertyNameCaseInsensitive = true,
                                Converters = { new JsonStringEnumConverter() }
                            };
                        var apiResponse = await response.Content.ReadFromJsonAsync<MessagesResponse>(options);
                        var messagesList = apiResponse?.Value;
                        if (messagesList != null && messagesList.Any())
                        {
                            // Get the latest non-user message
                            var latestAgentMessage = messagesList
                                .Where(m => m.Author.Role != Role.User)
                                .OrderByDescending(m => m.TimeStamp)
                                .FirstOrDefault();

                            if (latestAgentMessage != null)
                            {
                                var processingMessage2 = messages.LastOrDefault(m => !m.IsUser && m.Message == "Processing your request...");
                                if (processingMessage2 != null)
                                {
                                    int index = messages.IndexOf(processingMessage2);
                                    if (index >= 0)
                                    {
                                        // Update the processing message with the real response
                                        messages[index] = new ChatMessage
                                            {
                                                Message = latestAgentMessage.Text,
                                            // Fix: Apply markdown to the agent response
                                                FormattedMessage = Markdown.ToHtml(latestAgentMessage.Text, _markdownPipeline),
                                                IsUser = false,
                                                Timestamp = latestAgentMessage.TimeStamp
                                            };
                                        StateHasChanged();
                                        await ScrollToBottom();
                                        return;
                                    }
                                }
                                else
                                {
                                    // If we can't find the processing message, just add the new one
                                    messages.Add(new ChatMessage
                                        {
                                            Message = latestAgentMessage.Text,
                                        // Fix: Apply markdown to the agent response
                                            FormattedMessage = Markdown.ToHtml(latestAgentMessage.Text, _markdownPipeline),
                                            IsUser = false,
                                            Timestamp = latestAgentMessage.TimeStamp
                                        });
                                    StateHasChanged();
                                    await ScrollToBottom();
                                    return;
                                }
                            }
                        }
                    }
                }
            }

            // If we get here, we timed out waiting for a response
            var processingMessage = messages.LastOrDefault(m => !m.IsUser && m.Message == "Processing your request...");
            if (processingMessage != null)
            {
                int index = messages.IndexOf(processingMessage);
                if (index >= 0)
                {
                    messages[index] = new ChatMessage
                        {
                            Message = "The agent did not respond in time. Please try again.",
                            FormattedMessage = ApplyMarkdown("The agent did not respond in time. Please try again."),
                            IsUser = false,
                            Timestamp = DateTime.Now
                        };
                    StateHasChanged();
                    await ScrollToBottom();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error polling for response: {ex.Message}");
            var processingMessage = messages.LastOrDefault(m => !m.IsUser && m.Message == "Processing your request...");
            if (processingMessage != null)
            {
                int index = messages.IndexOf(processingMessage);
                if (index >= 0)
                {
                    messages[index] = new ChatMessage
                        {
                            Message = $"Error getting response: {ex.Message}",
                            FormattedMessage = ApplyMarkdown($"Error getting response: {ex.Message}"),
                            IsUser = false,
                            Timestamp = DateTime.Now
                        };
                    StateHasChanged();
                    await ScrollToBottom();
                }
            }
        }
    }

