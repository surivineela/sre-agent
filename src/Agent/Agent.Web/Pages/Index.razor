@page "/"
@page "/{*path}"
@using Agent.Core.Models
@using Agent.Web.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IChatService ChatService
@inject IJSRuntime JS
@inject IAgentManager AgentManager

<style>
    .selector-container {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        margin-bottom: 0.1rem; /* Reduced margin */
        padding: 0.20rem; /* Reduced padding */
        gap: 0.2rem; /* Reduced gap */
    }

    .thread-selector {
        flex: 2;
    }

    .agent-selector {
        flex: 1;
    }

    .thread-selector select,
    .agent-selector select {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        height: 38px;
    }

    .btn-new-chat {
        white-space: nowrap;
        height: 38px;
    }

    .chat-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 120px);
    }

    .messages-container {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        margin-bottom: 1rem;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .chat-input {
        margin-top: auto;
        padding: 1rem;
        background-color: #fff;
    }

    .chat-input form {
        display: flex;
        gap: 0.5rem;
    }

    .chat-input textarea {
        flex: 1;
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: none;
        min-height: 38px;
    }

    .chat-input button {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 4px;
        background-color: #0d6efd;
        color: white;
        cursor: pointer;
    }

    .chat-input button:disabled {
        background-color: #ccc;
        cursor: not-allowed;
    }
</style>

<div class="selector-container">
    <div class="thread-selector">
        <select @bind="CurrentThreadId">
            @foreach (var thread in threads)
            {
                <option value="@thread.Id">@thread.Name</option>
            }
        </select>
    </div>
    <button class="btn btn-primary btn-new-chat" @onclick="CreateNewThread">New Chat</button>
    <div class="agent-selector">
        <select @bind="CurrentPath">
            @foreach (var path in availablePaths)
            {
                <option value="@path">@FormatAgentName(path)</option>
            }
        </select>
    </div>
</div>

<div class="chat-container">
    <div class="messages-container" @ref="messagesDiv">
        @foreach (var message in messages)
        {
            <div class="message @(message.IsUser ? "user-message" : "assistant-message")">
                <div class="message-content">
                    @((MarkupString)message.Message)
                </div>
                <div class="message-timestamp">
                    @message.Timestamp.ToString("HH:mm")
                </div>
            </div>
        }
        @if (isTyping)
        {
            <div class="message assistant-message">
                <div class="message-content">
                    <span class="typing-animation">
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                    </span>
                </div>
                <div class="message-timestamp">@DateTime.Now.ToString("HH:mm")</div>
            </div>
        }
    </div>

    <div class="chat-input">
        <form @onsubmit="HandleSubmit">
            <textarea rows="1" @bind="currentMessage" @bind:event="oninput" placeholder="Type a message..."
                @onkeypress="HandleKeyPress" @ref="textAreaRef" />
            <button type="submit" disabled="@string.IsNullOrWhiteSpace(currentMessage)">
                <i class="bi bi-send-fill"></i>
            </button>
        </form>
    </div>
</div>

@code {
    private ElementReference messagesDiv;
    private ElementReference textAreaRef;
    private string currentMessage = "";
    private List<ChatMessage> messages = new();
    private bool isTyping = false;
    private string currentPath = "/";
    private List<string> availablePaths = new();
    private List<ChatThread> threads = new();
    private string? currentThreadId;

    [Parameter]
    public string? Path { get; set; }

    private string CurrentPath
    {
        get => currentPath;
        set
        {
            if (currentPath != value)
            {
                currentPath = value;
                ChatService.SwitchAgent(value, currentThreadId);
                messages.Clear();
                StateHasChanged();
                Navigation.NavigateTo(value);
            }
        }
    }

    private string? CurrentThreadId
    {
        get => currentThreadId;
        set
        {
            if (currentThreadId != value && !string.IsNullOrEmpty(value))
            {
                currentThreadId = value;
                _ = SwitchThreadAsync(value);
            }
        }
    }

    private async Task SwitchThreadAsync(string? threadId)
    {
        if (string.IsNullOrEmpty(threadId))
        {
            await CreateNewThread();
            return;
        }
        
        if (threadId == currentThreadId)
        {
            return;
        }

        await ChatService.SetThreadAsync(threadId);
        messages.Clear();
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(currentMessage))
            return;

        var userMessage = new ChatMessage
        {
            Message = currentMessage,
            IsUser = true
        };

        messages.Add(userMessage);
        var tempMessage = currentMessage;
        currentMessage = "";

        await ScrollToBottom();

        try
        {
            isTyping = true;
            StateHasChanged();

            var response = await ChatService.ProcessMessageAsync(tempMessage);
            isTyping = false;
            messages.Add(response);
            await ScrollToBottom();
        }
        catch
        {
            isTyping = false;
            messages.Add(new ChatMessage
            {
                Message = "Sorry, there was an error processing your request.",
                IsUser = false
            });
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await HandleSubmit();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottom();
        }
        await JS.InvokeVoidAsync("autoAdjustHeight", textAreaRef);
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("scrollToBottom", messagesDiv);
        }
        catch
        {
            // Handle any potential JS interop errors
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var availableAgentPaths = AgentManager.GetAvailableSubAgents().ToList();
        availablePaths = availableAgentPaths;

        // Handle the current path
        var requestedPath = string.IsNullOrEmpty(Path) ? "/" : $"/{Path}";

        // If the requested path is not available and not the root path,
        // redirect to root
        if (!availableAgentPaths.Contains(requestedPath, StringComparer.OrdinalIgnoreCase)
        && requestedPath != "/")
        {
            Navigation.NavigateTo("/");
            currentPath = "/";
        }
        else
        {
            currentPath = requestedPath;
        }

        ChatService.SwitchAgent(currentPath, currentThreadId);
        threads = await ChatService.GetThreadsAsync();

        // Create a new thread if there are no existing threads
        if (!threads.Any())
        {
            await CreateNewThread();
        }
        else
        {
            currentThreadId = threads[0].Id;
            await ChatService.SetThreadAsync(currentThreadId);
        }

        await base.OnInitializedAsync();
    }

    private async Task CreateNewThread()
    {
        var threadId = await ChatService.CreateThreadAsync(currentPath, "");
        threads = await ChatService.GetThreadsAsync(); // Get updated thread list first
        currentThreadId = threadId;
        await ChatService.SetThreadAsync(threadId);
        messages.Clear();
        StateHasChanged();
    }

    private string FormatAgentName(string path)
    {
        var name = path.TrimStart('/');
        if (string.IsNullOrWhiteSpace(name))
        {
            return "Meta Agent";
        }
        return char.ToUpper(name[0]) + name[1..] + " Agent";
    }
}
