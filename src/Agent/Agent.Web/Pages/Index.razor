    // Methods for handling thread purging
    private async Task ShowPurgeConfirmation()
    {
        showPurgeConfirmation = true;
        StateHasChanged();
    }

    private void CancelPurge()
    {
        showPurgeConfirmation = false;
        StateHasChanged();
    }

    private async Task PurgeAllThreads()
    {
        try
        {
            showPurgeConfirmation = false;
            StateHasChanged();

            // Show loading message
            messages.Clear();
            AddAssistantMessage("Deleting all conversations...");

            // Get all threads first
            await RefreshThreadsList();

            // Delete each thread one by one
            int deletedCount = 0;
            int failedCount = 0;

            foreach (var thread in threads.ToList()) // Use ToList() to avoid collection modification issues
            {
                if (Guid.TryParse(thread.Id, out Guid threadId))
                {
                    // Delete individual thread using ThreadsApiController
                    var client = HttpClientFactory.CreateClient("Razor");
                    var response = await client.DeleteAsync($"/api/v1/Threads/{threadId}");

                    if (response.IsSuccessStatusCode)
                    {
                        deletedCount++;
                    }
                    else
                    {
                        failedCount++;
                        Console.WriteLine($"Failed to delete thread {threadId}: {response.StatusCode}");
                    }
                }
            }

            // Clear localStorage and reset state
            await JS.InvokeVoidAsync("localStorage.removeItem", "chatId");
            currentChatId = null;

            // Refresh threads list
            await RefreshThreadsList();

            // Show results
            messages.Clear();
            if (failedCount > 0)
            {
                AddAssistantMessage($"Purge completed with some errors. Successfully deleted {deletedCount} conversations, failed to delete {failedCount}.");
            }
            else
            {
                AddAssistantMessage($"Successfully deleted all {deletedCount} conversations.");
            }

            // Create a new thread after purge
            await CreateNewThreadAndRefresh();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in PurgeAllThreads: {ex.Message}");
            messages.Clear();
            AddAssistantMessage($"Error purging threads: {ex.Message}");
        }
    }
