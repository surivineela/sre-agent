{
  "AppSettings": {
    "ApplicationName": "FirstPartyAgent.FunctionApp",
    "Environment": "Development",
    "Core": {
      "Azure": {
        "OpenSupportTickets": false,
        "OpenAI": {
          "LLMDeploymentName": "gpt-4o",
          "EmbeddingGeneratorDeploymentName": "text-embedding-ada-002",
          "Endpoint": "<your-openai-endpoint>",
          "ApiKey": "<your-openai-api-key>"
        }
      },
      "External": {
        "Teams": {
          "SendLogsToTeams": false, // or true if you want to invoke the LogicApp
          "TeamsEndpoint": "<logic-app-post-to-teams-workflow-endpoint>" // must be provided if SendLogsToTeams = true
        },
        "GitHub": {
          "PatTokenOverride": "<your-github-pat>"
        },
        "ICMAPI": {
          "Enabled": false
        },
        "ICMWorkflows": {
          "Enabled": false
        },
        "AzureSearch": {
          "SearchServiceUri": "<your-azure-search-uri>",
          "SearchApiKeyOverride": "<your-azure-search-api-key>",
          "SearchIndexes": [
            {
              "IndexName": "githubissues_azure_azure-functions-host",
              "FieldsToSelectCsv": "id,issueId,issueUrl,owner,repository,title,body,comments,labels,state,descriptiveSummary,createdTimestamp,lastUpdatedTimestamp",
              "SemanticSearchEnabled": false,
              "VectorSearchEnabled": true,
              "VectorFieldNamesCsv": "summaryVector"
            }
          ]
        },
        "Storage": {
          "AccountUrl": ""
        },
        "Observer": {
          "IsEnabled": "false"
        },
        "AzureAlerting": {
          "Endpoint": "https://azurealertingfunctions.azurewebsites.net/"
        },
        "AzureDevOps": {
          "Enabled": "false"
        }
      }
    }
  },
  "Serilog": {
    "KustoClusterUri": "",
    "KustoDatabase": "agentlogs",
    "KustoTable": "ApiLogs",
    "BatchPostingLimit": "100"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
