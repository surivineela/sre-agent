<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Agent.Runtime\Agent.Runtime.csproj" />
    <ProjectReference Include="..\Agent.Prometheus\Agent.Prometheus.csproj" />
    <ProjectReference Include="..\Agent.Web\Agent.Web.csproj" />
    <ProjectReference Include="..\Agent.Graph\Agent.Graph.csproj" />
    <ProjectReference Include="..\Agent.Tests.Common\Agent.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
   <Content Include="TestData\*.*">
