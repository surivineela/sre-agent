{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "actions": {
            "Check_if_message_is_from_listen-to-teams-channel": {
                "type": "If",
                "expression": {
                    "and": [
                        {
                            "equals": [
                                "@triggerBody()?['message']?['user']",
                                "ListenLogicAppWorkflow"
                            ]
                        }
                    ]
                },
                "actions": {
                    "Reply_with_a_message_in_a_channel-copy": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "referenceName": "teams"
                                }
                            },
                            "method": "post",
                            "body": {
                                "parentMessageId": "@triggerBody()?['message']?['messageId']",
                                "recipient": {
                                    "groupId": "53ae62b4-734e-484c-888e-f96574d40c7c",
                                    "channelId": "19:b80d005a3a2e49c6ac403aa0738d13a5@thread.tacv2"
                                },
                                "messageBody": "<p class=\"editor-paragraph\">****AI generated content****</p><p class=\"editor-paragraph\"><br>@{triggerBody()?['message']?['content']}</p>"
                            },
                            "path": "/v1.0/teams/conversation/replyWithMessage/poster/@{encodeURIComponent('User')}/location/@{encodeURIComponent('Channel')}"
                        }
                    }
                },
                "else": {
                    "actions": {
                        "Get_messages": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "referenceName": "teams"
                                    }
                                },
                                "method": "get",
                                "path": "/beta/teams/@{encodeURIComponent('53ae62b4-734e-484c-888e-f96574d40c7c')}/channels/@{encodeURIComponent('19:b80d005a3a2e49c6ac403aa0738d13a5@thread.tacv2')}/messages"
                            }
                        },
                        "Find_post_for_given_issue_number": {
                            "type": "Query",
                            "inputs": {
                                "from": "@body('Get_messages')?['value']",
                                "where": "@and(\n  not(empty(item()?['subject'])),\n  equals(\n    trim(\n      if(\n        contains(item()?['subject'], ']'),\n        substring(item()?['subject'], add(indexOf(item()?['subject'], ']'), 1), sub(length(item()?['subject']), add(indexOf(item()?['subject'], ']'), 1))),\n        item()?['subject']\n      )\n    ),\n    triggerBody()?['message']['title']\n  )\n)\n"
                            },
                            "runAfter": {
                                "Get_messages": [
                                    "SUCCEEDED"
                                ]
                            }
                        },
                        "Found_thread_with_same_issue_title": {
                            "type": "If",
                            "expression": {
                                "and": [
                                    {
                                        "greater": [
                                            "@length(body('Find_post_for_given_issue_number'))",
                                            0
                                        ]
                                    }
                                ]
                            },
                            "actions": {
                                "For_each": {
                                    "type": "Foreach",
                                    "foreach": "@body('Find_post_for_given_issue_number')",
                                    "actions": {
                                        "Reply_with_a_message_in_a_channel": {
                                            "type": "ApiConnection",
                                            "inputs": {
                                                "host": {
                                                    "connection": {
                                                        "referenceName": "teams"
                                                    }
                                                },
                                                "method": "post",
                                                "body": {
                                                    "parentMessageId": "@item()?['id']",
                                                    "recipient": {
                                                        "groupId": "53ae62b4-734e-484c-888e-f96574d40c7c",
                                                        "channelId": "19:b80d005a3a2e49c6ac403aa0738d13a5@thread.tacv2"
                                                    },
                                                    "messageBody": "<p class=\"editor-paragraph\">****AI generated content****</p><p class=\"editor-paragraph\"><br>@{triggerBody()?['message']?['content']}</p>"
                                                },
                                                "path": "/v1.0/teams/conversation/replyWithMessage/poster/@{encodeURIComponent('User')}/location/@{encodeURIComponent('Channel')}"
                                            }
                                        }
                                    }
                                }
                            },
                            "else": {
                                "actions": {
                                    "Post_message_with_subject_if_no_matching_post_found": {
                                        "type": "ApiConnection",
                                        "inputs": {
                                            "host": {
                                                "connection": {
                                                    "referenceName": "teams"
                                                }
                                            },
                                            "method": "post",
                                            "body": {
                                                "recipient": {
                                                    "groupId": "53ae62b4-734e-484c-888e-f96574d40c7c",
                                                    "channelId": "19:b80d005a3a2e49c6ac403aa0738d13a5@thread.tacv2"
                                                },
                                                "messageBody": "<p class=\"editor-paragraph\">****AI generated content****</p><br><p class=\"editor-paragraph\">@{triggerBody()?['message']?['content']}</p>",
                                                "subject": "@triggerBody()?['message']?['title']"
                                            },
                                            "path": "/beta/teams/conversation/message/poster/@{encodeURIComponent('User')}/location/@{encodeURIComponent('Channel')}"
                                        }
                                    }
                                }
                            },
                            "runAfter": {
                                "Find_post_for_given_issue_number": [
                                    "SUCCEEDED"
                                ]
                            }
                        }
                    }
                },
                "runAfter": {}
            }
        },
        "contentVersion": "1.0.0.0",
        "outputs": {},
        "triggers": {
            "When_a_HTTP_request_is_received": {
                "type": "Request",
                "kind": "Http",
                "inputs": {
                    "method": "POST",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "message": {
                                "type": "object",
                                "properties": {
                                    "user": {
                                        "type": "string"
                                    },
                                    "title": {
                                        "type": "string"
                                    },
                                    "content": {
                                        "type": "string"
                                    },
                                    "image": {
                                        "type": "string"
                                    },
                                    "messageId": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "kind": "Stateful"
}
