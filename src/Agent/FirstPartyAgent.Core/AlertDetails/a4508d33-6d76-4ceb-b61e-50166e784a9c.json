  "PrimaryKustoQuery": {
    "Title": "[FlexConsumption] [Hot]SLA Site Ping Failures more than 10 in 1hr",
    "KustoQuery": "let _endTime = now();,
    "let" "_lookBackInterval",
    "=" "1h;",
    "let" "_startTime",
    "=" "_endTime-_lookBackInterval;",
    "let" "flexConsumptionStamps",
    "=" "cluster('wawscus.kusto.windows.net').database('wawsprod').FlexConsumptionClusterStampMapping",
    "|" "where",
    "IsActive" "|",
    "distinct" "AntaresStamp;",
    "RunnersV2PingResultsTable" "|",
    "where" "PreciseTimeStamp",
    "between" "(_startTime",
    ".._endTime" ")",
    "|" "where",
    "StampName" "in",
    "(flexConsumptionStamps)" // filter for stamps with fix - Task 27339908: Cache WorkerInfo in SubLevelLeaseOwner
    "|",
    "where" "Name",
    "startswith" "\\\"sla-ws-func-\\\"",
    "|" "where",
    "Name" "contains",
    "\\\"-fc\\\"" "|",
    "where" "SlaStatus",
    "!=" "long(200)",
    "|" "summarize",
    "count()" "by",
    "Name",
    "SlaStatus",
    "StampName",
    "RunnerName",
    "AntaresStamp" "=",
    "StampName" "|",
    "where" "count_",
    ">" 15,
    "|" "join",
    "kind=inner" "cluster('wawscus.kusto.windows.net').database('wawsprod').FlexConsumptionDashboardClusterStampMapping",
    "on" "AntaresStamp",
    "|" "extend",
    "TsgId=" "strcat(\\\"https://dataexplorer.azure.com/dashboards/ccfbf904-9e0e-4162-8738-9fd20840fbf3?\\\",",
    "\\\"p-_startTime=\\\", tostring(_startTime)," "\\\"&p-_endTime=\\\", tostring(_endTime),",
    "\\\"&p-_azureRegion=v-\\\", AzureRegion," "\\\"&p-AntaresCluster=\\\", url_encode(AntaresKustoClusterDashboardParam),",
    "\\\"&p-_antaresStamp=v-\\\", AntaresStamp," "\\\"&p-_appName=v-\\\",Name,",
    "\\\"&p-_numRows=v-100#dbea4188-18ab-43cc-acf8-fe901f22ccee\\\")"
    // ------------------------------------------------------------------------------
    "|",
    "project" "Name",
    "count_",
    "SlaStatus",
    "StampName",
    "RunnerName",
    "CorrelationId" "=",
    "StampName",
    "TsgId\",": null,
    "IsGraphInReport": false,
    "Position": 0
  },
  "MooncakeKustoQuery": null,
  "MooncakeKustoClusters": null,
  "FairfaxKustoQuery": null,
  "FairfaxKustoClusters": null,
  "UssecKustoQuery": null,
  "UssecKustoClusters": null,
  "UsnatKustoQuery": null,
  "UsnatKustoClusters": null,
  "SecondaryKustoQueries": [
    {
      "Title": "Level 2 FunctionsPlatformLog Errors",
      "KustoQuery": "FunctionsPlatformLogs,
      "|" "where",
      "PreciseTimeStamp" ">=",
      "ago(1h)" "|",
      "where" "EventPrimaryStampName",
      "==" "\\\"{StampName}\\\"",
      "|" "parse",
      "EventPrimaryStampName" "with",
      "\\\"waws-\\\" Stamp" "|",
      "extend" "SlaSiteNamePrefix",
      "=" "strcat(\\\"sla-ws-func-\\\", Stamp, \\\"-v4-\\\")",
      "|" "where",
      "SiteName" "startswith",
      "SlaSiteNamePrefix" "|",
      "where" "Level",
      "<" 3,
      "|" "distinct",
      "Exception",
      "Message",
      "SiteName\",": null,
      "IsGraphInReport": false,
      "Position": 1
    },
    {
      "Title": "Timechart of SlaStatus for SLA sites w/failed pings",
      "KustoQuery": "RunnersV2PingResultsTable,
      "|" "where",
      "TIMESTAMP" ">",
      "ago(3h)" "|",
      "where" "StampName",
      "==" "\\\"{StampName}\\\"",
      "|" "where",
      "Name" "==",
      "\\\"{Name}\\\"" "|",
      "project" "SlaStatus",
      "PreciseTimeStamp" "|",
      "order" "by",
      "PreciseTimeStamp" "|",
      "render" "timechart\",",
      "IsGraphInReport": true,
      "Position": 2
    },
    {
      "Title": "Subscription Level Lease Owner Mapping Change",
      "KustoQuery": "AntaresRuntimeDataServiceEvents,
      "|" "where",
      "TIMESTAMP" ">",
      "ago(1h)" "|",
      "where" "EventPrimaryStampName",
      "==" "\\\"{StampName}\\\"",
      "|" "where",
      "Details" "contains",
      "\\\"GetSubscriptionLevelPartitionMapping\\\" and Details contains \\\"Forcing cache update\\\"" "|",
      "project" "PreciseTimeStamp",
      "Pid",
      "RoleInstance",
      "Details" "|",
      "order" "by",
      "PreciseTimeStamp" "asc\",",
      "IsGraphInReport": false,
      "Position": 3
    },
    {
      "Title": "Checking the behavior of the  SyncRequestSlotForSite Latency",
      "KustoQuery": "AntaresDataServiceApiTransactions,
      "|" "where",
      "TIMESTAMP" ">",
      "ago(1h)" "|",
      "where" "RequestUrl",
      "contains" "\\\"{Name}\\\"",
      "|" "where",
      "OperationName" "==",
      "\\\"SyncRequestSlotsForSite\\\"" "|",
      "where" "EventPrimaryStampName",
      "==" "\\\"{StampName}\\\"",
      "|" "where",
      "LatencyInMilliseconds" ">",
      5000 "|",
      "project" "PreciseTimeStamp",
      "RoleInstance",
      "OperationName",
      "LatencyInMilliseconds",
      "ErrorDetails" "|",
      "take" 10,
      ",: null,
      "IsGraphInReport": false,
      "Position": 4
    },
    {
      "Title": "Find the status from Front End Role ",
      "KustoQuery": "AntaresIISLogFrontEndTable,
      "|" "where",
      "TIMESTAMP" ">",
      "ago(1h)" "|",
      "where" "S_sitename",
      "startswith" "\\\"sla-ws-func-\\\"",
      "|" "where",
      "S_sitename" "contains",
      "\\\"-fc\\\"" "|",
      "where" "EventPrimaryStampName",
      "==" "\\\"{StampName}\\\"",
      "|" "where",
      "Sc_status" ">",
      299 "|",
      "where" "Sc_win32_status",
      "!=" "RequestCanceled,ClientGone",
      "|" "order",
      "by" "PreciseTimeStamp",
      "asc" "|",
      "project" "PreciseTimeStamp",
      "RoleInstance",
      "ActivityId",
      "S_sitename",
      "Cs_uri_stem",
      "ServerRouted",
      "User_agent",
      "Sc_status",
      "Sc_substatus",
      "Sc_win32_status",
      "Time_taken",
      "UrlRewriteTime",
      "ArrTime",
      "DSCallTime",
      "CacheResult",
      "EventPrimaryStampName" "|",
      "take" 100,
      ",: null,
      "IsGraphInReport": false,
      "Position": 5
    }
  ],
