{
  "id": "9c6594e6-8d77-491e-b801-c481eb9f6d69",
  "ServiceName": "App Service (Web Apps)",
  "ServiceId": "10060",
  "IsAutoApproved": true,
  "CreatedBy": "tonychoi@microsoft.com",
  "LastUpdated": "2025-05-16T17:02:21.9616301+00:00",
  "Title": "[FlexConsumption] Cosmos Timeout Failures During Specialization",
  "Description": "<p>Alert to detect if there's frequent timeout failures in cosmos query from dataroles. This is to keep track of how often cosmos timeout failures occur.</p><p>Use the TSG to see if the sla sites have failed during this time and mitigate if the issue has stopped.</p>",
  "Clouds": [],
  "MinimumHitCount": 1,
  "Tags": [
    "tonychoi",
    "app service (web apps)",
    "sev3",
    "tsushi",
    "larohra",
    "adid"
  ],
  "PrimaryKustoQuery": {
    "Title": "Stamps with cosmos timeout failures",
    "KustoQuery": "// [FlexConsumption] Cosmos Timeout Failures During Specialization,
    "let" "_endTime",
    "=" "now();",
    "let" "_lookBackInterval",
    "=" "1h;",
    "let" "_startTime",
    "=" "_endTime-_lookBackInterval;",
    "let" "THRESHOLD",
    "=" "100;",
    "let" "LATENCY_THRESHOLD",
    "=" 30,
    "*" "1000;",
    "FunctionsPlatformLogs" "|",
    "where" "PreciseTimeStamp",
    "between" "(_startTime",
    ".._endTime)" "|",
    "where" "EventPrimaryStampName",
    "in" "(AllFlexConsumptionAntaresStamps())",
    "|" "where",
    "Source" "==",
    "\\\"CosmosLogger\\\"" "|",
    "where" "SourceMemberName",
    "==" "\\\"GetItemsWithQuery\\\"",
    "|" "where",
    "LatencyInMilliseconds" ">",
    "LATENCY_THRESHOLD" "|",
    "parse" "DocumentId",
    "with" "\\\"Query='SELECT * from c WHERE c.partitionKey = @partitionKey AND c.documentType = @documentType' Parameters='[\\\\\\\"@partitionKey=functionsworkerpod::\\\"SiteName\\\"\\\\\\\",\\\\\\\"@documentType=FunctionsWorkerPod\\\\\\\"]'\\\"",
    "|" "extend",
    "AntaresStamp" "=",
    "EventPrimaryStampName" "|",
    "summarize" "count()",
    "by" "AntaresStamp",
    "|" "join",
    "kind=inner" "cluster('wawscus.kusto.windows.net').database('wawsprod').FlexConsumptionDashboardClusterStampMapping",
    "on" "AntaresStamp",
    "|" "extend",
    "TsgId=" "strcat(\\\"https://dataexplorer.azure.com/dashboards/ccfbf904-9e0e-4162-8738-9fd20840fbf3?\\\",",
    "\\\"p-_startTime=\\\", tostring(_startTime)," "\\\"&p-_endTime=\\\", tostring(_endTime),",
    "\\\"&p-_azureRegion=v-\\\", AzureRegion," "\\\"&p-AntaresCluster=\\\", url_encode(AntaresKustoClusterDashboardParam),",
    "\\\"&p-_antaresStamp=v-\\\", AntaresStamp," "\\\"#0e14a4ae-b621-420d-a75b-9f6d89c62d9a\\\"",
    ")" "|",
    "where" "count_",
    ">" "THRESHOLD",
    "|" "extend",
    "CorrelationId" "=",
    "AntaresStamp" "|",
    "distinct" "CorrelationId",
    "count_",
    "TsgId\",": null,
    "IsGraphInReport": false,
    "Position": 0
  },
  "MooncakeKustoQuery": null,
  "MooncakeKustoClusters": null,
  "FairfaxKustoQuery": null,
  "FairfaxKustoClusters": null,
  "UssecKustoQuery": null,
  "UssecKustoClusters": null,
  "UsnatKustoQuery": null,
  "UsnatKustoClusters": null,
  "SecondaryKustoQueries": [
    {
      "Title": "Activity IDs of Timeouts",
      "KustoQuery": "let LATENCY_THRESHOLD = 30 * 1000;,
      "FunctionsPlatformLogs" "|",
      "where" "PreciseTimeStamp",
      ">=" "ago(1h)",
      "|" "where",
      "EventPrimaryStampName" "in",
      "(AllFlexConsumptionAntaresStamps())" "|",
      "where" "Source",
      "==" "\\\"CosmosLogger\\\"",
      "|" "where",
      "SourceMemberName" "==",
      "\\\"GetItemsWithQuery\\\"" "|",
      "where" "LatencyInMilliseconds",
      ">" "LATENCY_THRESHOLD",
      "|" "parse",
      "DocumentId" "with",
      "\\\"Query='SELECT * from c WHERE c.partitionKey = @partitionKey AND c.documentType = @documentType' Parameters='[\\\\\\\"@partitionKey=functionsworkerpod::\\\"SiteName\\\"\\\\\\\",\\\\\\\"@documentType=FunctionsWorkerPod\\\\\\\"]'\\\"" "|",
      "distinct" "ActivityId",
      "SiteName" "|",
      "take" 10,
      ",: null,
      "IsGraphInReport": false,
      "Position": 1
    },
    {
      "Title": "Lease Owner Change checking (Check SyncReuestSlotForSite exists)",
      "KustoQuery": "AntaresDataServiceApiTransactions,
      "|" "where",
      "PreciseTimeStamp" ">=",
      "ago(1h)" "|",
      "where" "EventPrimaryStampName",
      "==" "\\\"{CorrelationId}\\\"",
      "|" "where",
      "OperationName" "in",
      "(\\\"SyncRequestSlotsStatus\\\", \\\"SyncRequestSlotsForSite\\\", \\\"RemoveRequestSlotsForSite\\\", \\\"MarkFrontEndSyncComplete\\\", \\\"GetSubscriptionLevelPartitionMapping\\\", \\\"AddRequestSlotForSite\\\", \\\"EnsureFlexConsumptionAlwaysReadyInstances\\\")" "|",
      "project" "PreciseTimeStamp",
      "RoleInstance",
      "OperationName",
      "RequestUrl",
      "LatencyInMilliseconds",
      "StatusCode",
      "Level",
      "ActivityId" "|",
      "summarize" "count()",
      "min(LatencyInMilliseconds)",
      "max(LatencyInMilliseconds)",
      "round(avg(LatencyInMilliseconds))",
      "percentile(LatencyInMilliseconds",
      "90)",
      "percentile(LatencyInMilliseconds",
      "99)" "by",
      "OperationName",
      "StatusCode" "|",
      "order" "by",
      "OperationName\",": null,
      "IsGraphInReport": false,
      "Position": 2
    },
    {
      "Title": "Trend of SyncRequestSlot calls",
      "KustoQuery": "AntaresDataServiceApiTransactions,
      "|" "where",
      "PreciseTimeStamp" ">=",
      "ago(10d)" "|",
      "where" "EventPrimaryStampName",
      "==" "\\\"{CorrelationId}\\\"",
      "|" "where",
      "OperationName" "in",
      "(\\\"SyncRequestSlotsForSite\\\")" "|",
      "project" "PreciseTimeStamp",
      "RoleInstance",
      "OperationName",
      "RequestUrl",
      "LatencyInMilliseconds",
      "StatusCode",
      "Level",
      "ActivityId" "|",
      "summarize" "count()",
      "by" "bin(PreciseTimeStamp",
      "1h)",
      "StatusCode" ",,
      "IsGraphInReport": true,
      "Position": 3
    },
    {
      "Title": "Check if failures mainly in SyncRequestSlots Operation",
      "KustoQuery": "// [FlexConsumption] There's known issues with SyncRequestSlot failures that can cause high latency in Cosmos writes. The fix for this might be rolled out in ANT104 (Check in with Anjana for the details).,
      "AntaresDataServiceApiTransactions" "|",
      "where" "PreciseTimeStamp",
      ">" "ago(1h)",
      "|" "where",
      "EventPrimaryStampName" "==",
      "\\\"{CorrelationId}\\\"" "|",
      "where" "OperationName",
      "in" "(\\\"SyncRequestSlotsForSite\\\", \\\"AddRequestSlotForSite\\\")",
      "|" "where",
      "StatusCode" ">=",
      500 "|",
      "project" "PreciseTimeStamp",
      "RoleInstance",
      "OperationName",
      "RequestUrl",
      "LatencyInMilliseconds",
      "StatusCode",
      "Level",
      "ActivityId" "|",
      "summarize" "count()",
      "by" "bin(PreciseTimeStamp",
      "10m)",
      "OperationName" "|",
      "render" "timechart",
      "with(series=OperationName)" ",,
      "IsGraphInReport": true,
      "Position": 4
    },
    {
      "Title": "Validate High Number of SyncRequestSlot Requests",
      "KustoQuery": "// if count is greater than 1M - SRS huge traffic,
      "let" "_endTime",
      "=" "now();",
      "let" "_lookBackInterval",
      "=" "1h;",
      "let" "_startTime",
      "=" "_endTime-_lookBackInterval;",
      "AntaresDataServiceApiTransactions" "|",
      "where" "PreciseTimeStamp",
      "between" "(_startTime",
      ".." "_endTime)",
      "|" "where",
      "EventPrimaryStampName" "==",
      "\\\"{CorrelationId}\\\"" "|",
      "where" "OperationName",
      "in" "(\\\"SyncRequestSlotsForSite\\\")",
      "|" "summarize",
      "count()" "by",
      "bin(PreciseTimeStamp",
      "1h)\",": null,
      "IsGraphInReport": false,
      "Position": 5
    },
    {
      "Title": "Determine DR Process Restart",
      "KustoQuery": "// Determine DR Process Restart,
      "let" "_antaresStamp",
      "=" "\\\"{CorrelationId}\\\";",
      "let" "_binInterval",
      "=" "'10m';",
      "let" "_endTime",
      "=" "now();",
      "let" "_lookBackInterval",
      "=" "1h;",
      "let" "_startTime",
      "=" "_endTime-_lookBackInterval;",
      "AntaresDataServiceApiTransactions" "|",
      "where" "PreciseTimeStamp",
      "between" "(_startTime",
      ".." "_endTime)",
      "|" "where",
      "isempty(_antaresStamp)" "or",
      "EventPrimaryStampName" "==",
      "_antaresStamp" "|",
      "where" "Role",
      "==" "\\\"DataRole\\\"",
      "|" "where",
      "OperationName" "contains",
      "\\\"status\\\"" "|",
      "summarize" "count()",
      "by" "strcat(RoleInstance",
      "\\\"_\\\", Pid), bin(PreciseTimeStamp, totimespan(_binInterval))" "|",
      "summarize" "count()",
      "by" "PreciseTimeStamp\",",
      "IsGraphInReport": false,
      "Position": 6
    }
  ],
