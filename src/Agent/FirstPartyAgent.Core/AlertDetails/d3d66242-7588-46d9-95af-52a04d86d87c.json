  "PrimaryKustoQuery": {
    "Title": "Cold site failures by SiteName",
    "KustoQuery": "// [FlexConsumption] SLA Site - Cold Start failures,
    // [FlexConsumption] Cold site failures
    "let" "_endTime",
    "=" "now();",
    "let" "_lookBackInterval",
    "=" "1h;",
    "let" "_startTime",
    "=" "_endTime-_lookBackInterval;",
    "RunnersV2PingResultsTable" "|",
    "where" "PreciseTimeStamp",
    "between" "(_startTime",
    ".._endTime" ")",
    "|" "where",
    "RunnerName" "==",
    "\\\"RunnersV3 Functions_ColdSite\\\"" "|",
    "where" "StampName",
    "in" "(AllFlexConsumptionAntaresStamps())",
    "|" "extend",
    "CorrelationId" "=",
    "StampName" "|",
    "where" "Name",
    "startswith" "\\\"sla-ws-func-\\\"",
    "|" "where",
    "Name" "contains",
    "\\\"-fc\\\"" "|",
    "where" "Name",
    "contains" "\\\"cold\\\"",
    "|" "where",
    "HealthStatus" "==",
    "\\\"Unhealthy\\\"" "|",
    "summarize" "count()",
    "by" "CorrelationId",
    "Name",
    "SlaStatus",
    "RunnerName",
    "HealthStatus" "|",
    "summarize" "totalFailuresPerStamp",
    "=" "sum(count_)",
    "by" "CorrelationId",
    "AntaresStamp" "=",
    "CorrelationId" "|",
    "where" "totalFailuresPerStamp",
    ">=5" // More than 5 cold start failures in the past hour
    "|",
    "join" "kind=inner",
    "cluster('wawscus.kusto.windows.net').database('wawsprod').FlexConsumptionDashboardClusterStampMapping" "on",
    "AntaresStamp" "|",
    "extend" "TsgId=",
    "strcat(\\\"https://dataexplorer.azure.com/dashboards/ccfbf904-9e0e-4162-8738-9fd20840fbf3?\\\"," "\\\"p-_startTime=\\\", tostring(_startTime),",
    "\\\"&p-_endTime=\\\", tostring(_endTime)," "\\\"&p-_azureRegion=v-\\\", AzureRegion,",
    "\\\"&p-AntaresCluster=\\\", url_encode(AntaresKustoClusterDashboardParam)," "\\\"&p-_antaresStamp=v-\\\", CorrelationId,",
    "\\\"&p-_numRows=v-100#dbea4188-18ab-43cc-acf8-fe901f22ccee\\\")"
    // ------------------------------------------------------------------------------
    "|",
    "project" "totalFailuresPerStamp",
    "CorrelationId",
    "TsgId" ",,
    "IsGraphInReport": false,
    "Position": 0
  },
