    {
      "Title": "Possibility 1 -- not all FEs are ready!",
      "KustoQuery": "let timeWindow = ago(1h);,
      "let" "affectedSites",
      "=" "RunnersV2PingResultsTable",
      "|" "where",
      "PreciseTimeStamp" ">=",
      "timeWindow" "|",
      "where" "RunnerName",
      "==" "\\\"RunnersV3 Functions_ColdSite\\\"",
      "|" "where",
      "StampName" "in",
      "(AllFlexConsumptionAntaresStamps())" "|",
      "extend" "CorrelationId",
      "=" "StampName",
      "|" "where",
      "Name" "startswith",
      "\\\"sla-ws-func-\\\"" "|",
      "where" "Name",
      "contains" "\\\"-fc\\\"",
      "|" "where",
      "Name" "contains",
      "\\\"cold\\\"" "|",
      "where" "Name",
      "!in" "(\\\"sla-ws-func-prod-db3-287-v4-cold-fc-001\\\", \\\"sla-ws-func-prod-blu-457-v4-cold-fc-001\\\", \\\"sla-ws-func-prod-msftintch1-503-v4-cold-fc-001\\\")",
      "|" "where",
      "HealthStatus" "==",
      "\\\"Unhealthy\\\"" "|",
      "distinct" "Name;",
      "let" "successfulAddRequestSlot=AntaresDataServiceApiTransactions",
      "|" "where",
      "PreciseTimeStamp" ">=",
      "timeWindow" "|",
      "where" "OperationName",
      "==" "\\\"AddRequestSlotForSite\\\"",
      "|" "extend",
      "SiteName" "=",
      "extract(\\\"/sites/(.*?)/\\\", 1, RequestUrl)" "|",
      "where" "SiteName",
      "in" "(affectedSites)",
      "|" "extend",
      "CorrelationId" "=",
      "EventPrimaryStampName" "|",
      "where" "StatusCode",
      "==" 200,
      "|" "extend",
      "UniqueActivityIdAndStamp" "=",
      "strcat(ActivityId",
      "\\\"-\\\", EventPrimaryStampName)" "|",
      "distinct" "UniqueActivityIdAndStamp;",
      "FunctionsPlatformLogs" "|",
      "where" "PreciseTimeStamp",
      ">=" "timeWindow",
      "|" "extend",
      "CorrelationId" "=",
      "EventPrimaryStampName" "|",
      "extend" "UniqueActivityIdAndStamp",
      "=" "strcat(ActivityId",
      "\\\"-\\\", EventPrimaryStampName)" "|",
      "where" "UniqueActivityIdAndStamp",
      "in" "(successfulAddRequestSlot)",
      "|" "where",
      "Message" "contains",
      "\\\"We are trying to acquire request slots, however, not all FEs are ready!\\\"  or Message contains \\\"[Cold Start] AddRequestSlotsForSite\\\"" "|",
      "distinct" "SiteName",
      "Message",
      "EventPrimaryStampName",
      "CorrelationId\",": null,
      "IsGraphInReport": false,
      "Position": 2
    },
