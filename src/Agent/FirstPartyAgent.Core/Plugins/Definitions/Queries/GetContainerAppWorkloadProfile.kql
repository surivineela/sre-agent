let queryFrom = datetime("##fromDate##");
let queryTo = datetime("##toDate##");
let containerAppOrJobName = "##containerAppOrJobName##"; 
ContainerAppDBState
| where TIMESTAMP between (queryFrom .. queryTo)
| where containerAppName =~ containerAppOrJobName or containerAppsJobName =~ containerAppOrJobName
| take 1
| project  workloadProfileType
