let fromTime = datetime("##fromDate##");
let toTime = datetime("##toDate##");
let queryManagedCluster = "##managedCluster##";
ManagedEnvironmentDBState
| where TIMESTAMP between (fromTime-1d .. toTime)
| where managedClusterName == queryManagedCluster
| summarize arg_max(TIMESTAMP,managedClusterName,subscription,resourceGroup,environmentName)
