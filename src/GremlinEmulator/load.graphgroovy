import org.apache.tinkerpop.gremlin.structure.io.graphml.GraphMLIo
import org.slf4j.LoggerFactory
import java.nio.file.*

// grab an SLF4J logger
def logger = LoggerFactory.getLogger("gremlin-script")

// Function to convert filename to camelCase graph name
def toCamelCase(String filename) {
    // Remove .graphml extension
    def name = filename.replaceAll('\\.graphml$', '')
    // Split on hyphens and underscores, then camelCase
    def parts = name.split('[-_]')
    def result = parts[0].toLowerCase()
    for (int i = 1; i < parts.length; i++) {
        result += parts[i].toLowerCase().capitalize()
    }
    return result
}

try {
    logger.info("🔄 Starting dynamic GraphML discovery and load")
    
    // Discover all .graphml files in the graphs directory
    def graphsDir = Paths.get('/opt/graphs')
    def graphmlFiles = []
    
    if (Files.exists(graphsDir) && Files.isDirectory(graphsDir)) {
        Files.list(graphsDir).forEach { path ->
            if (path.toString().endsWith('.graphml')) {
                graphmlFiles.add(path.fileName.toString())
            }
        }
    }
    
    logger.info("📁 Discovered ${graphmlFiles.size()} GraphML files: ${graphmlFiles}")
    
    def globals = [:]
    
    // Load each discovered graph
    graphmlFiles.each { filename ->
        def graphName = toCamelCase(filename)
        def traversalSourceName = 'g' + graphName
        
        logger.info("📂 Loading graph: ${filename} -> ${graphName} (traversal: ${traversalSourceName})")
        
        try {
            // Get the graph instance by name (it should be defined in gremlin-server.yaml)
            def graph = this.binding.getVariable(graphName)
            
            if (graph != null) {
                // Load the GraphML file
                graph.io(GraphMLIo.build()).readGraph("/opt/graphs/${filename}")
                
                // Verify by counting vertices and edges
                def vCount = graph.traversal().V().count().next()
                def eCount = graph.traversal().E().count().next()
                logger.info("✅ ${graphName} loaded successfully: ${vCount} vertices, ${eCount} edges")
                
                // Create traversal source
                globals[traversalSourceName] = traversal().withEmbedded(graph)
                logger.info("🎯 Traversal source '${traversalSourceName}' created")
            } else {
                logger.warn("⚠️  Graph '${graphName}' not found in server configuration - skipping ${filename}")
            }
            
        } catch (Exception ex) {
            logger.error("❌ Failed to load ${filename}: ${ex.message}", ex)
        }
    }
    
    logger.info("🎉 Dynamic graph loading complete! Available traversal sources: ${globals.keySet()}")
    return globals

} catch (FileNotFoundException fnf) {
  logger.error("❌ File not found: ${fnf.message}", fnf)
  throw fnf

} catch (Exception ex) {
  logger.error("❌ Error loading GraphML:", ex)
  throw ex
}