{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "publish Agent.Web",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "src/Agent/Agent.Web/Agent.Web.csproj",
                "-o",
                "out/publish",
                "-p:SkipReactAppBuild=true"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}