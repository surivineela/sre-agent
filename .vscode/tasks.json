{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "publish Agent.Web",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "src/Agent/Agent.Web/Agent.Web.csproj",
                "-o",
                "out/publish",
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build Agent.Web",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "src/Agent/Agent.Web/Agent.Web.csproj",
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build Agent.Cmd",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "src/Agent/Agent.Cmd/Agent.Cmd.csproj"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build Session.Proxy",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "src/Agent/Session.Proxy/Session.Proxy.csproj"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build Session.Identity",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "src/Agent/Session.Identity/Session.Identity.csproj"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch Agent.Web",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/Agent/Agent.Web/Agent.Web.csproj"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always"
            },
            "isBackground": true,
            "problemMatcher": "$msCompile"
        }
    ]
}