{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
        "name": "Launch Agent.Web (HTTPS)",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build Agent.Web",
        "program": "${workspaceFolder}/src/Agent/Agent.Web/bin/Debug/net9.0/Agent.Web.dll",
        "args": [],
        "cwd": "${workspaceFolder}/src/Agent/Agent.Web",
        "stopAtEntry": false,
        "env": {
            "ASPNETCORE_ENVIRONMENT": "Development",
            "ASPNETCORE_URLS": "https://localhost:7023"
        },
        "serverReadyAction": {
            "action": "openExternally",
            "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
            "uriFormat": "%s/static"
        },
        "sourceFileMap": {
            "/Views": "${workspaceFolder}/Views"
        },
        "requireExactSource": true
    },
  ]
}
